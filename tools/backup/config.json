{
  "branch": "auto-backup",
  "remote": "origin",
  "include": [
    "src/**",
    "assets/**",
    "docs/**",
    "tests/**",
    "tools/**",
    "scripts/**",
    "packaging/**",
    "CMakeLists.txt",
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "exclude": [
    "build*/**",
    "**/build*/**",
    "**/.git/**",
    "**/.atlas/**",
    "**/.turbo/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*.o",
    "**/*.a",
    "**/*.so",
    "**/*.tmp",
    "**/*.log",
    "**/*.ini",
    "**/*.xwd",
    "**/*.core",
    "**/*.mp4",
    "**/*.mov",
    "**/*.mkv",
    "**/*.avi",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/.aws/**",
    "**/.codex/**",
    "**/.agents/**",
    "**/.opencode/**",
    "**/.gnupg/**",
    "third_party/**",
    "projects/**",
    "referencias/**",
    "midia/**",
    "backups/**",
    "cache/**",
    "Testing/**"
  ],
  "max_file_bytes": 4194304,
  "max_total_bytes": 209715200,
  "checkpoint_interval_seconds": 120,
  "poll_interval_seconds": 15,
  "push_retry_seconds": 45,
  "push_timeout_seconds": 60,
  "secret_scan": true
}
