/* LINBLUX Player — composição independente do Studio, mesma identidade
   monocromática: preto, branco e brancos translúcidos. Sem marca de cor. */
#game-layer { position: absolute; overflow: hidden; font-size: 16px; color: #FFFFFF; }
#game-layer button, #game-layer input { tab-index: auto; focus: auto; }
#game-layer button * { focus: none; }

/* Topbar do jogo */
#game-topbar { position: absolute; display: flex; top: 16px; left: 16px; align-items: center; z-index: 3; }
#game-topbar button { width: 46px; height: 46px; flex-shrink: 0; margin: 0; padding: 10px; border: 1px transparent; border-radius: 23px; background-color: transparent; }
#game-topbar img, #game-topbar .menu-button img { display: block; width: 26px; height: 26px; margin: 0 auto; }
#game-topbar .logo-button { padding: 8px; margin-right: 10px; background-color: #141414CC; }
#game-topbar .logo-button img { width: 28px; height: auto; max-height: 28px; margin: auto; }
#game-capsule { display: flex; padding: 0 6px; border-radius: 23px; background-color: #141414CC; }
#game-topbar button:hover { background-color: #FFFFFF12; border-color: transparent; }
#game-topbar button:active { background-color: #FFFFFF26; }
#game-topbar button.selected { background-color: #FFFFFF26; }
#game-topbar button:focus { border-color: #FFFFFF; }

/* Health renderizado na textura de gameplay (C++). */
#health { display: none; pointer-events: none; }

/* Cursor de software */
#mouse-lock-cursor { position: absolute; display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; margin: -14px 0 0 -14px; pointer-events: none; focus: none; }
#mouse-lock-cursor img { display: block; width: auto; height: auto; max-width: 28px; max-height: 28px; margin: 0; focus: none; }

/* ---------- Menu de pausa (sidebar) ---------- */
#pause { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; z-index: 2; padding: 0; background-color: #00000085; }
#pause-panel.pause-panel { position: absolute; left: 0; top: 0; bottom: 0; width: 90%; max-width: 900px; height: 100%; max-height: none; padding: 0; border: 0; border-right: 1px #FFFFFF20; border-radius: 0; display: flex; flex-direction: row; background-color: #151519f5; }
.pause-sidebar { display: flex; flex-direction: column; width: 176px; flex: 0 0 176px; height: 100%; padding: 14px 10px; background-color: #101013b8; }
.pause-brand { display: flex; align-items: center; height: 48px; margin-bottom: 14px; font-size: 17px; font-weight: bold; color: #FFFFFF; }
.pause-brand img { width: 34px; height: auto; margin-right: 8px; }
.pause-brand span { color: #FFFFFF; }
#pause .pause-tabs { display: flex; flex-direction: column; flex: 1; min-height: 0; height: auto; margin: 8px 0; border: 0; overflow: auto; }
#pause .pause-tabs button { flex: 0 0 40px; min-height: 40px; height: 40px; width: 100%; justify-content: flex-start; padding: 8px 12px; border: 0; border-left: 3px transparent; border-radius: 6px; background-color: transparent; font-size: 15px; color: #B8B8B8; display: flex; align-items: center; }
#pause .pause-tabs button img { width: 20px; height: 20px; margin-right: 10px; image-color: #B8B8B8; display: block; }
#pause .pause-tabs button:hover { background-color: #FFFFFF10; color: #FFFFFF; }
#pause .pause-tabs button:hover img { image-color: #FFFFFF; }
#pause .pause-tabs button.active { color: #FFFFFF; background-color: #FFFFFF26; border-left-color: #FFFFFF; }
#pause .pause-tabs button.active img { image-color: #FFFFFF; }
#pause .pause-tabs button:focus { border-left-color: #FFFFFF; background-color: #FFFFFF12; }
#pause #resume, #pause #leave { flex: 0 0 40px; height: 40px; font-size: 14px; }
#pause #leave { color: #FFFFFF; background-color: #FFFFFF10; border-radius: 6px; margin-top: 8px; }
#pause #leave:hover { background-color: #FFFFFF20; }
.pause-main { display: flex; flex-direction: column; flex: 1; width: 1px; min-width: 0; height: 100%; padding: 0 18px 14px; overflow: hidden; }
.pause-heading { display: flex; align-items: center; height: 56px; border-bottom: 1px #FFFFFF10; margin-bottom: 8px; color: #FFFFFF; font-size: 16px; font-weight: bold; }
#pause-experience { flex: 1; overflow: hidden; font-size: 16px; color: #FFFFFF; }
#pause-close { width: 32px; height: 32px; font-size: 22px; padding: 0; border-radius: 6px; background-color: transparent; border: 1px transparent; color: #B8B8B8; }
#pause-close:hover { background-color: #FFFFFF12; color: #FFFFFF; }
#pause #pause-content { width: 100%; flex: 1; min-height: 0; overflow: auto; font-size: 14px; color: #FFFFFF; padding-right: 4px; }
#pause #pause-content h2 { font-size: 18px; margin: 0 0 8px; color: #FFFFFF; }
#pause #pause-content .muted { color: #858585; }

/* Linhas de configuração */
#pause .setting-row { flex-direction: column; align-items: flex-start; width: 100%; padding: 10px 0; border-bottom: 1px #FFFFFF10; }
#pause .setting-control { margin-top: 8px; width: 100%; display: flex; align-items: center; gap: 10px; }
#pause .setting-copy { width: 100%; }
#pause .setting-copy span { display: block; font-size: 14px; color: #FFFFFF; }
#pause .setting-copy small { display: block; font-size: 11px; color: #858585; margin-top: 6px; line-height: 1.35; }

/* Botões de ciclo */
#pause .cycle { justify-content: space-between; width: 100%; }
#pause .cycle button { width: 40px; height: 36px; padding: 6px; border: 1px #FFFFFF20; border-radius: 6px; background-color: #141414; color: #FFFFFF; }
#pause .cycle button img { width: 20px; height: 20px; margin: 0; image-color: #FFFFFF; display: block; }
#pause .cycle button:hover { background-color: #FFFFFF12; border-color: #FFFFFF40; }
#pause .cycle button:focus { border-color: #FFFFFF; background-color: #FFFFFF12; }
#pause .cycle .cycle-value, #pause #camera-mode { flex: 1; text-align: center; width: auto; font-size: 14px; color: #B8B8B8; white-space: nowrap; padding: 0 8px; background-color: #141414; border: 1px #FFFFFF20; border-radius: 6px; height: 36px; display: flex; align-items: center; justify-content: center; }

/* Sliders */
#pause .slider-control { display: flex; align-items: center; width: 100%; gap: 10px; }
#pause .slider-control input[type=range] { flex: 1; width: auto; min-width: 90px; height: 20px; margin: 0; padding: 0; border: 0; background-color: transparent; }
#pause .slider-control slidertrack { height: 5px; margin-top: 10px; border-radius: 3px; background-color: #FFFFFF20; }
#pause .slider-control sliderbar { width: 16px; height: 20px; margin-top: 2px; border-radius: 6px; background-color: #FFFFFF; border: 1px #FFFFFF40; }
#pause .slider-control sliderprogress { height: 5px; border-radius: 3px; background-color: #FFFFFF40; }
#pause .slider-control sliderbar:hover, #pause .slider-control sliderbar:active { background-color: #FFFFFF; }
#pause .slider-control sliderarrowdec, #pause .slider-control sliderarrowinc { width: 0; }
#pause .slider-control input.player-number { width: 72px; height: 32px; flex-shrink: 0; text-align: center; padding: 4px 4px; font-size: 13px; border-radius: 6px; border: 1px #FFFFFF30; background-color: #141414CC; color: #FFFFFF; }
#pause .slider-control input.player-number:focus { background-color: #FFFFFF10; border-color: #FFFFFF; }
#pause .slider-value { width: 56px; flex-shrink: 0; text-align: right; font-size: 14px; color: #B8B8B8; }

/* Player card / sessão */
#pause .player-card { display: flex; align-items: center; padding: 10px; border-radius: 0; border-bottom: 1px #FFFFFF20; background-color: transparent; }
#pause .player-emblem { width: 52px; height: 52px; flex: 0 0 52px; padding: 10px; border-radius: 8px; background-color: #FFFFFF10; margin-right: 12px; }
#pause .player-emblem img { width: 34px; height: 34px; }
#pause .player-identity { flex: 1; min-width: 0; }
#pause .player-eyebrow { font-size: 10px; letter-spacing: 0.5px; color: #858585; }
#pause .player-card h2 { margin: 3px 0; font-size: 15px; color: #FFFFFF; }
#pause .session-indicator { font-size: 12px; color: #B8B8B8; }
#pause .session-logo { width: 38px; height: auto; max-height: 38px; margin-left: 10px; }
#pause .session-row { display: flex; justify-content: space-between; padding: 13px 8px; font-size: 14px; border-bottom: 1px #FFFFFF10; color: #FFFFFF; }
#pause .session-row b { display: block; width: 60%; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #FFFFFF; }
#pause .session-actions { display: flex; width: 40%; margin: 0; }
#pause .session-actions button { flex: 1; margin-right: 6px; height: 36px; padding: 4px 6px; font-size: 12px; border: 1px #FFFFFF20; background-color: #FFFFFF0e; border-radius: 6px; color: #FFFFFF; }
#pause .session-actions button:last-child { margin-right: 0; }
#pause .session-actions button:hover { background-color: #FFFFFF20; border-color: #FFFFFF40; }
#pause .key-hint { font-size: 10px; color: #858585; margin-left: 6px; }
#pause .session-note { font-size: 11px; color: #858585; line-height: 1.4; margin: 12px 8px; }

/* Rodapé */
.pause-footer { display: flex; height: 64px; flex: 0 0 64px; padding-top: 8px; border: 0; }
.pause-footer button { display: flex; flex: 1; align-items: center; justify-content: center; height: 52px; padding: 8px 8px; border: 1px #FFFFFF20; background-color: #FFFFFF10; border-radius: 8px; font-size: 16px; font-weight: bold; color: #FFFFFF; margin-right: 8px; }
.pause-footer button:last-child { margin-right: 0; }
.pause-footer button img { width: 22px; height: 22px; margin-right: 10px; image-color: #FFFFFF; display: block; }
.pause-footer button.primary { background-color: #FFFFFF; border-color: #FFFFFF; color: #0B0B0B; }
.pause-footer button:hover { background-color: #FFFFFF26; }
.pause-footer button.primary:hover { background-color: #FFFFFF; }
.pause-footer button:active { background-color: #FFFFFF40; }
.pause-footer button:focus { border-color: #FFFFFF; }
.footer-key { width: 26px; height: 26px; padding: 4px 0; margin-right: 10px; font-size: 10px; border: 1px #FFFFFF40; border-radius: 4px; color: #B8B8B8; background-color: #FFFFFF0a; }

/* Controles */
.control-row { display: flex; align-items: center; padding: 11px 8px; min-height: 50px; border-bottom: 1px #FFFFFF10; }
#pause #controls-page kbd { display: block; text-align: center; width: 124px; min-width: 124px; margin-right: 20px; padding: 6px; background-color: #FFFFFF0e; border: 1px #FFFFFF40; border-radius: 5px; font-size: 12px; color: #FFFFFF; }
#pause #controls-page .control-row span { font-size: 14px; color: #FFFFFF; }

/* Sobre */
#pause #about-page { display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 100%; text-align: center; padding: 24px 15px; }
#pause #about-page .about-logo { width: 72px; height: auto; max-height: 72px; margin: 0 auto 16px; }
#pause #about-page h1 { font-size: 26px; color: #FFFFFF; margin: 0 0 8px; }
#pause #about-page p { font-size: 14px; color: #B8B8B8; margin: 4px 0; }
#pause #player-setting-error { color: #FFFFFF; font-size: 11px; margin: 0 8px; }

/* Scrollbar do conteúdo de pausa */
#pause #pause-content scrollbarvertical { width: 7px; }
#pause #pause-content scrollbarvertical slidertrack { background-color: transparent; }
#pause #pause-content scrollbarvertical sliderbar { width: 3px; margin-left: 2px; background-color: #FFFFFF40; border-radius: 2px; }

/* Compacto (telas pequenas) */
.player-compact #pause { padding: 0; }
.player-compact .pause-panel { width: 94%; max-width: 760px; border-radius: 6px; }
.player-compact .pause-sidebar { width: 150px; flex: 0 0 150px; padding: 10px 8px; }
.player-compact .pause-tabs, .player-compact .pause-tabs button { height: 34px; flex-basis: 34px; }
.player-compact .pause-tabs button { font-size: 13px; padding: 6px 8px; }
.player-compact .pause-tabs button img { width: 18px; height: 18px; margin-right: 6px; }
.player-compact .setting-row { padding: 8px 0; }
.player-compact .setting-control { margin-top: 6px; }
.player-compact .setting-copy span, .player-compact .cycle-value { font-size: 13px; }
.player-compact .setting-copy small { font-size: 10px; margin-top: 4px; }
.player-compact .session-row { font-size: 13px; padding: 11px 6px; }
.player-compact .pause-footer { height: 56px; flex-basis: 56px; }
.player-compact .pause-footer button { height: 46px; font-size: 14px; margin-right: 6px; }
.player-compact .pause-footer button:last-child { margin-right: 0; }
.player-compact .footer-key { width: 24px; height: 24px; padding: 3px 0; margin-right: 6px; }
.player-compact .pause-footer img { width: 20px; height: 20px; margin-right: 6px; }
.player-compact .player-card { padding: 8px; }
.player-compact #pause #pause-content h2 { font-size: 16px; }
.player-compact .session-indicator { font-size: 11px; }
.player-compact .session-actions button { font-size: 11px; height: 32px; }
