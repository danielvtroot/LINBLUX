/* LINBLUX Studio — design system monocromático.
   Preto profundo #0B0B0B, preto sólido #141414 / #1C1C1C, branco e brancos
   translúcidos. Sem vermelho, azul ou qualquer cor de marca no chrome. */
body { display: block; margin: 0; font-family: DejaVu Sans; font-size: 12px; color: #FFFFFF; background-color: transparent; }
div, p, h1, h2, h3 { display: block; }
* { box-sizing: border-box; }
b, strong { font-weight: bold; }
p { margin: 8px 0; line-height: 1.5; }
h1 { margin: 5px 0 10px; font-size: 24px; font-weight: bold; }
h2 { margin: 3px 0 12px; font-size: 17px; font-weight: bold; }
h3 { margin: 8px 0; font-size: 13px; font-weight: bold; }
.muted { color: #858585; }

/* ---------- Botões (contrato único) ---------- */
button { display: inline-block; height: 36px; min-height: 36px; padding: 0 14px; background-color: #1C1C1C; border: 1px #FFFFFF20; border-radius: 6px; color: #FFFFFF; font-family: DejaVu Sans; font-size: 13px; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
button:hover { background-color: #FFFFFF12; border-color: #FFFFFF50; }
button:active, button.active { background-color: #FFFFFF26; border-color: #FFFFFF; }
button:focus { border-color: #FFFFFF; outline: none; }
button.active:focus { border-color: #FFFFFF; }
button:disabled { color: #858585; border-color: #FFFFFF0a; background-color: #141414; cursor: default; opacity: 0.5; }
button.primary { background-color: #FFFFFF; border-color: #FFFFFF; color: #0B0B0B; }
button.primary:hover { background-color: #FFFFFF; border-color: #FFFFFF; }
button.quiet { background-color: transparent; border-color: transparent; color: #FFFFFF; }
button.quiet:hover { background-color: #FFFFFF12; }
button.quiet:active, button.quiet.active { background-color: #FFFFFF26; }
button.close { width: 28px; height: 28px; padding: 0; background-color: transparent; border-color: transparent; border-radius: 4px; color: #FFFFFF; font-size: 17px; }
button.close:hover { background-color: #FFFFFF12; }
button.close:active { background-color: #FFFFFF26; }
button img { width: 16px; height: 16px; margin-right: 8px; vertical-align: middle; display: block; margin: 0 auto; }

/* Toolbar / ribbon buttons compactos */
.toolbar button, .group-tools button { height: 40px; min-height: 40px; width: 56px; min-width: 56px; flex: 0 0 56px; padding: 6px 4px; border-radius: 6px; background-color: transparent; border-color: transparent; font-size: 11px; }
.toolbar button img, .group-tools button img { width: 22px; height: 22px; margin: 0 auto 6px; }
.toolbar button:hover, .group-tools button:hover { background-color: #FFFFFF12; border-radius: 6px; }
.toolbar button.active, .group-tools button.active { background-color: #FFFFFF26; }
.toolbar button:disabled, .group-tools button:disabled { opacity: 0.45; }

/* Inputs */
input, select, textarea { background-color: #141414; border: 1px #FFFFFF20; border-radius: 6px; color: #FFFFFF; font-family: DejaVu Sans; font-size: 12px; padding: 6px 10px; height: 34px; }
input:focus, select:focus, textarea:focus { border-color: #FFFFFF; background-color: #1C1C1C; }
input[type=checkbox] { width: 16px; height: 16px; padding: 0; vertical-align: middle; margin-right: 8px; background-color: #141414; border: 1px #FFFFFF40; border-radius: 4px; }
input[type=checkbox]:checked { background-color: #FFFFFF; decorator: none; }
select selectarrow { width: 8px; height: 5px; background-color: #FFFFFF40; margin: 0 4px; border-radius: 2px; }
select selectbox { background-color: #1C1C1C; border: 1px #FFFFFF40; padding: 2px; }
select option { padding: 4px 7px; color: #FFFFFF; background-color: #141414; }
select option:hover, select option:checked { background-color: #FFFFFF26; }
scrollbarvertical { width: 10px; margin: 0; }
scrollbarhorizontal { height: 10px; margin: 0; }
scrollbarvertical slidertrack, scrollbarhorizontal slidertrack { background-color: #141414; }
scrollbarvertical sliderbar { width: 8px; min-height: 22px; margin-left: 1px; background-color: #FFFFFF20; border-radius: 4px; }
scrollbarhorizontal sliderbar { height: 8px; min-width: 22px; margin-top: 1px; background-color: #FFFFFF20; border-radius: 4px; }
scrollbarvertical sliderbar:hover, scrollbarhorizontal sliderbar:hover { background-color: #FFFFFF40; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0px; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0px; }

/* ---------- Header / Tabs ---------- */
#header { position: absolute; top: 0; left: 0; right: 0; height: 44px; display: flex; align-items: center; background-color: #0B0B0B; border-bottom: 1px #FFFFFF10; padding: 0 12px; }
.brand { display: flex; align-items: center; width: 200px; flex-shrink: 0; }
.brand img { width: 28px; height: 28px; margin-right: 10px; }
.brand b { font-size: 16px; letter-spacing: 0.5px; }
.brand span { margin-left: 8px; font-size: 11px; color: #B8B8B8; }
#project { flex: 1; font-size: 12px; color: #B8B8B8; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.session { display: flex; align-items: center; }
.session button { height: 30px; min-width: 34px; padding: 3px 8px; margin-left: 6px; background-color: transparent; border-color: transparent; border-radius: 4px; font-size: 12px; color: #B8B8B8; }
.session button:hover { background-color: #FFFFFF12; color: #FFFFFF; }
.session button:active { background-color: #FFFFFF26; }
.session img { margin: 0 4px; width: 16px; height: 16px; }
.separator { width: 1px; height: 18px; margin: 0 8px; background-color: #FFFFFF20; }
#tabs { position: absolute; top: 44px; left: 0; right: 0; height: 36px; padding-left: 12px; display: flex; align-items: center; background-color: #141414; border-bottom: 1px #FFFFFF10; }
#tabs button { height: 36px; min-width: 70px; padding: 0 14px; border: 0; border-radius: 0; background-color: transparent; font-size: 12px; color: #B8B8B8; }
#tabs button:hover { background-color: #FFFFFF0a; color: #FFFFFF; }
#tabs button.active { background-color: #FFFFFF10; border-bottom: 2px #FFFFFF; color: #FFFFFF; }
.tab-spacer { flex: 1; }

/* ---------- Ribbon ---------- */
#ribbon { position: absolute; left: 0; right: 0; top: 80px; height: 88px; padding: 4px 12px 0 12px; background-color: #141414; border-bottom: 1px #FFFFFF10; display: flex; align-items: flex-start; overflow: hidden; }
#ribbon-tools { display: flex; flex-grow: 0; flex-shrink: 1; height: 82px; overflow: hidden; min-width: 0; }
#ribbon-spacer { flex: 1 1 auto; height: 82px; min-width: 4px; }
.ribbon-page { display: flex; flex-grow: 0; flex-shrink: 0; height: 82px; }
.ribbon-group { height: 80px; display: flex; flex-direction: column; padding: 0 6px; margin-right: 6px; border-right: 1px #FFFFFF10; flex-grow: 0; flex-shrink: 0; }
.group-tools { display: flex; flex-direction: column; align-items: center; height: 74px; }
.group-name { flex: 0 0 16px; font-size: 10px; text-align: center; color: #858585; padding-top: 2px; }

/* ---------- Snap group ---------- */
#snap-group { position: absolute; right: 12px; top: 4px; display: flex; flex-direction: column; width: 220px; padding: 4px 6px 2px; background-color: #141414; border: 1px #FFFFFF10; border-radius: 6px; z-index: 10; }
#snap-group label { display: block; font-size: 11px; white-space: nowrap; margin-bottom: 4px; color: #B8B8B8; }
#snap-group label input[type=checkbox] { width: 13px; height: 13px; margin: 0 4px 0 0; vertical-align: middle; }
.snap-checks { display: flex; flex-direction: row; align-items: center; width: 100%; height: 26px; flex-shrink: 0; }
.snap-row { display: flex; flex-direction: row; align-items: flex-end; width: 100%; height: 36px; }
.snap-heading { display: flex; width: 100%; height: 22px; align-items: center; }
.snap-heading label { width: 72px; margin-bottom: 0; }
#transform-space { width: 60px; height: 24px; padding: 1px 4px; font-size: 11px; flex: 0 0 60px; margin-right: 6px; }
.handle-size { display: flex; flex-direction: column; width: 118px; height: 56px; padding: 4px 4px; font-size: 11px; }
.handle-size select { width: 100%; height: 24px; margin-top: 4px; font-size: 11px; }
.snap-field { width: 48px; margin-right: 4px; flex: 0 0 48px; }
.snap-field span { display: block; font-size: 10px; color: #858585; margin-bottom: 2px; }
.snap-field input { width: 100%; height: 24px; padding: 2px 4px; font-size: 11px; }

/* ---------- Panels ---------- */
.panel { position: absolute; background-color: #141414CC; border: 1px #FFFFFF20; border-radius: 6px; overflow: hidden; }
.panel-heading { height: 34px; padding: 6px 10px; background-color: #1C1C1C; border-bottom: 1px #FFFFFF10; font-size: 12px; font-weight: bold; color: #FFFFFF; display: flex; align-items: center; }
.panel-heading img { width: 16px; height: 16px; margin-right: 8px; vertical-align: middle; }
.panel-heading .close { float: right; margin-top: -1px; }
.heading-actions { float: right; margin-top: -1px; }
.heading-actions button { width: 28px; height: 26px; padding: 0; margin-left: 4px; background-color: transparent; border-color: transparent; border-radius: 4px; font-size: 17px; color: #B8B8B8; }
.heading-actions button:hover { background-color: #FFFFFF12; color: #FFFFFF; }
.search { width: 96%; margin: 6px 2%; height: 30px; font-size: 11px; }
.toolbox-filter { height: 60px; padding: 6px; border-bottom: 1px #FFFFFF10; }
.toolbox-filter select, .toolbox-filter input { display: block; width: 100%; height: 30px; margin-bottom: 6px; font-size: 11px; }
.panel-content { width: 100%; padding: 6px 8px; overflow: auto; }
.tool-section { padding: 6px 4px; font-size: 11px; color: #B8B8B8; border-bottom: 1px #FFFFFF10; margin-bottom: 6px; }
.object-grid { display: flex; flex-wrap: wrap; width: 100%; margin-bottom: 10px; }
.object-grid button { flex: 0 0 31%; width: 31%; height: 64px; margin: 2px 1%; padding: 8px 0 4px; border: 1px transparent; border-radius: 6px; background-color: transparent; font-size: 10px; color: #FFFFFF; }
.object-grid button:hover { background-color: #FFFFFF12; border-color: #FFFFFF20; }
.object-grid button:active { background-color: #FFFFFF26; }
.object-grid img { display: block; width: 26px; height: 26px; margin: 0 auto 6px; }
.object-grid span { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.list-command { display: block; width: 100%; height: 32px; padding: 6px 8px; text-align: left; background-color: transparent; border: 1px transparent; border-radius: 6px; font-size: 11px; color: #FFFFFF; }
.list-command:hover { background-color: #FFFFFF12; border-color: #FFFFFF20; }
.list-command:active { background-color: #FFFFFF26; }
.tool-note { font-size: 10px; color: #858585; margin: 12px 4px; }
#tree { width: 100%; overflow: auto; padding: 1px 0 6px; }
.tree-row { display: flex; align-items: center; width: 100%; height: 26px; padding: 0 6px; white-space: nowrap; cursor: pointer; border: 1px transparent; border-radius: 4px; }
.tree-row:hover { background-color: #FFFFFF10; }
.tree-row.selected { background-color: #FFFFFF26; color: #FFFFFF; }
.tree-row.drop-target { border: 1px #FFFFFF50; background-color: #FFFFFF10; }
.tree-row img { flex-shrink: 0; width: 16px; height: 16px; margin-right: 8px; }
.tree-row .node-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.tree-row .fold { flex: 0 0 16px; width: 16px; height: 16px; margin-right: 4px; padding: 2px; border: 1px #FFFFFF20; border-radius: 3px; background-color: transparent; }
.tree-row .fold img { width: 10px; height: 10px; margin: 0; }
.tree-row .leaf { flex: 0 0 18px; width: 18px; }
#property-title { padding: 6px 10px; height: 34px; border-bottom: 1px #FFFFFF10; font-size: 11px; color: #FFFFFF; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; }
#property-title span { margin-left: 8px; color: #B8B8B8; font-size: 10px; }
#property-body { width: 100%; padding: 0; overflow: auto; }
.property-group { height: 30px; padding: 4px 10px; background-color: #1C1C1C; border-bottom: 1px #FFFFFF10; font-size: 11px; font-weight: bold; color: #FFFFFF; display: flex; align-items: center; }
.property { display: flex; align-items: center; width: 100%; height: 32px; border-bottom: 1px #FFFFFF10; }
.property label { flex: 0 0 44%; width: 44%; height: 100%; padding: 0 10px; border-right: 1px #FFFFFF10; color: #B8B8B8; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: flex; align-items: center; }
.property input, .property select { flex: 1; width: 56%; min-width: 0; height: 28px; padding: 4px 6px; font-size: 11px; background-color: transparent; border: 1px transparent; border-radius: 4px; color: #FFFFFF; }
.property input:hover { border-color: #FFFFFF40; }
.property input[type=checkbox] { flex: 0 0 16px; width: 16px; height: 16px; margin-left: 8px; padding: 0; border: 1px #FFFFFF40; border-radius: 4px; }
.property .readonly { flex: 1; padding: 4px 6px; font-size: 10px; color: #B8B8B8; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.property-help { padding: 4px 10px 8px; color: #858585; font-size: 10px; }
.empty-state { padding: 10px 8px; color: #858585; font-size: 11px; }
.property-action { margin: 6px; height: 30px; font-size: 11px; }
.property .color-button { flex: 0 0 20px; width: 20px; height: 18px; padding: 0; margin-right: 6px; border: 1px #FFFFFF40; border-radius: 4px; }

/* Image picker */
.image-picker { width: 100%; padding: 4px 6px 6px; border-bottom: 1px #FFFFFF10; background-color: #1C1C1C; }
.image-current { display: flex; align-items: center; width: 100%; min-height: 46px; margin-bottom: 3px; }
.image-current-thumb { flex: 0 0 42px; width: 42px; height: 42px; margin-right: 8px; background-color: #141414; border: 1px #FFFFFF20; border-radius: 4px; }
.image-current-name { flex: 1; min-width: 0; font-size: 11px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #FFFFFF; }
.image-missing { flex: 0 0 auto; margin-right: 6px; padding: 2px 6px; background-color: #FFFFFF10; border-radius: 4px; font-size: 9px; color: #FFFFFF; }
.image-current button { flex: 0 0 auto; }
.image-query { width: 100%; height: 30px; margin: 2px 0 4px; padding: 4px 8px; font-size: 11px; background-color: #141414; border: 1px #FFFFFF20; border-radius: 6px; color: #FFFFFF; }
.image-options { width: 100%; max-height: 196px; overflow: auto; padding: 2px; background-color: #141414; border: 1px #FFFFFF20; border-radius: 6px; }
.image-option { display: flex; align-items: center; width: 100%; height: 42px; padding: 2px 4px; border: 1px transparent; border-radius: 4px; background-color: transparent; text-align: left; font-size: 11px; color: #FFFFFF; }
.image-option:hover { background-color: #FFFFFF12; border-color: #FFFFFF20; }
.image-option.selected { background-color: #FFFFFF26; border-color: #FFFFFF; }
.image-option img { flex: 0 0 34px; width: 34px; height: 34px; margin-right: 8px; }
.image-option-name { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.image-option-type { flex: 0 0 auto; margin-left: 8px; color: #858585; font-size: 9px; }
.image-empty { padding: 10px; color: #858585; font-size: 10px; }
.image-picker-actions button { height: 30px; margin: 4px 4px 0 0; font-size: 10px; }

/* Viewport label / documents */
#viewport-label { position: absolute; height: 30px; padding: 0; background-color: #1C1C1C; border-top: 1px #FFFFFF10; display: flex; align-items: stretch; justify-content: flex-start; font-size: 11px; overflow: hidden; color: #B8B8B8; }
#document-list { display: flex; flex: 1; min-width: 0; height: 30px; overflow: hidden; }
.document-tab { display: flex; flex: 0 1 auto; min-width: 0; height: 30px; border-right: 1px #FFFFFF10; background-color: #141414; }
.document-tab.active { background-color: #1C1C1C; border-top: 2px #FFFFFF; }
.document-tab .doc-activate { display: flex; align-items: center; height: 28px; max-width: 200px; padding: 2px 8px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; background-color: transparent; border: 0; border-radius: 0; font-size: 11px; color: #B8B8B8; }
.document-tab .doc-activate img { width: 13px; height: 13px; margin-right: 6px; flex-shrink: 0; }
.document-tab .doc-label { flex: 0 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.document-tab.active .doc-activate { color: #FFFFFF; }
.document-tab .doc-close { flex-shrink: 0; width: 24px; height: 24px; margin: 2px 4px 0 0; padding: 0; border: 0; border-radius: 4px; background-color: transparent; color: #B8B8B8; font-size: 15px; line-height: 22px; }
.document-tab .doc-close:hover { background-color: #FFFFFF12; color: #FFFFFF; }
.document-tab .doc-dirty { width: 8px; height: 8px; margin-left: 6px; border-radius: 4px; background-color: #FFFFFF; flex-shrink: 0; }
#viewport-hint { flex-shrink: 0; margin: 6px 10px 0 12px; white-space: nowrap; }
#editor-camera-modes { display: flex; flex-shrink: 0; padding: 2px 6px; }
#editor-camera-modes button { height: 24px; width: 48px; padding: 2px 4px; border-radius: 4px; font-size: 10px; margin: 0 2px; background-color: #141414; border: 1px #FFFFFF20; color: #B8B8B8; }
#editor-camera-modes button:hover { background-color: #FFFFFF12; color: #FFFFFF; border-color: #FFFFFF40; }
#editor-camera-modes button.active { background-color: #FFFFFF26; border-color: #FFFFFF; color: #FFFFFF; }
.compact #viewport-hint { display: none; }
#viewport-title img { width: 14px; height: 14px; margin-right: 5px; vertical-align: middle; }
.divider { position: absolute; background-color: #FFFFFF10; }
.divider:hover { background-color: #FFFFFF30; }
.vertical { cursor: ew-resize; }
.horizontal { cursor: ns-resize; }
#advanced { position: absolute; background-color: transparent; }
#advanced-tabs { height: 32px; padding: 0 4px; border-top: 1px #FFFFFF10; background-color: #141414; display: flex; align-items: center; }
#advanced-tabs button { flex: 0 0 auto; height: 30px; padding: 0 10px; background-color: transparent; border: 0; border-radius: 0; font-size: 11px; color: #B8B8B8; }
#advanced-tabs button:hover { background-color: #FFFFFF0a; color: #FFFFFF; }
#advanced-tabs button.active { background-color: #1C1C1C; border-top: 2px #FFFFFF; color: #FFFFFF; }
#advanced-tabs .close { margin-left: auto; font-size: 17px; color: #B8B8B8; }
#advanced-tabs .close:hover { color: #FFFFFF; }
#advanced-content { position: absolute; top: 32px; bottom: 0; left: 0; right: 0; overflow: auto; padding: 8px 10px; background-color: #141414CC; }
.config-fields { display: flex; flex-wrap: wrap; width: 100%; padding: 4px 0 10px; }
.config-field { display: flex; flex: 0 0 48%; width: 48%; height: 32px; margin-right: 2%; align-items: center; justify-content: space-between; font-size: 11px; color: #B8B8B8; }
.config-field input, .config-field select { width: 52%; height: 28px; font-size: 11px; }
.config-field input[type=checkbox] { width: 16px; height: 16px; }
.asset-grid { display: flex; flex-wrap: wrap; padding: 10px 0; }
.asset-card { width: 176px; margin: 0 8px 8px 0; padding: 8px; border: 1px #FFFFFF20; border-radius: 6px; background-color: #1C1C1C; }
.asset-card .asset-preview { display: block; width: auto; height: auto; max-width: 110px; max-height: 90px; margin: 0 auto 6px; }
.asset-card span { display: block; font-size: 10px; margin-bottom: 4px; color: #B8B8B8; }
.asset-card .asset-name { font-size: 11px; color: #FFFFFF; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.asset-card .asset-meta { color: #858585; font-size: 9px; margin-bottom: 8px; }
.asset-card button { font-size: 10px; padding: 3px; margin: 0 3px 3px 0; height: 26px; }

/* Status */
#status { position: absolute; bottom: 0; left: 0; right: 0; height: 30px; padding: 6px 12px; display: flex; justify-content: space-between; background-color: #0B0B0B; border-top: 1px #FFFFFF10; font-size: 11px; color: #B8B8B8; }
#message { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
#scene-count { margin-left: 16px; }

/* Context menu / tooltip / dialog */
#context-menu { position: absolute; width: 200px; padding: 4px; background-color: #141414CC; border: 1px #FFFFFF20; border-radius: 6px; }
#context-menu button { display: block; width: 100%; height: 32px; padding: 6px 10px; text-align: left; border: 1px transparent; border-radius: 4px; background-color: transparent; font-size: 12px; color: #FFFFFF; }
#context-menu button:hover { background-color: #FFFFFF12; }
#context-menu button:active { background-color: #FFFFFF26; }
#tooltip { position: absolute; max-width: 300px; padding: 6px 10px; background-color: #0B0B0BEE; border: 1px #FFFFFF30; border-radius: 4px; font-size: 11px; color: #FFFFFF; pointer-events: none; }
#dialog-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; background-color: #000000CC; }
#dialog { width: 480px; max-width: 92%; max-height: 90%; padding: 24px; background-color: #141414CC; border: 1px #FFFFFF20; border-radius: 8px; overflow: auto; }
#dialog h2 { margin: 0 0 12px; font-size: 18px; color: #FFFFFF; }
#dialog-value { width: 100%; height: 36px; }
.dialog-footer { display: flex; justify-content: flex-end; padding-top: 16px; gap: 8px; }
.dialog-footer button { min-width: 90px; }
#dialog-error { color: #FFFFFF; margin-top: 8px; font-size: 11px; }
.palette { display: flex; flex-wrap: wrap; padding: 8px 0; gap: 6px; }
.palette button { flex: 0 0 28px; width: 28px; height: 28px; margin: 0; padding: 0; border-radius: 4px; border: 1px #FFFFFF20; }

/* Compact adjustments */
.compact .group-tools button { width: 50px; min-width: 50px; flex-basis: 50px; font-size: 10px; padding: 4px 2px; }
.compact .ribbon-group { padding: 0 4px; margin-right: 4px; }
.compact .group-tools img { width: 20px; height: 20px; margin-bottom: 4px; }

/* Image references dialog */
.image-usages { max-height: 200px; overflow: auto; }
.image-usage { padding: 6px 0; border-bottom: 1px #FFFFFF20; }
.image-usage span { display: block; margin-bottom: 4px; font-size: 12px; color: #FFFFFF; }
.image-usage button { height: 30px; margin-right: 6px; padding: 4px 8px; }
#dialog { max-height: 88%; overflow: auto; }
.image-picker, .image-query, .image-options, .image-option { box-sizing: border-box; }
.asset-card { box-sizing: border-box; }
button.image-locked { opacity: 0.45; pointer-events: none; }

/* Áudio */
.audio-heading { display: flex; align-items: flex-start; justify-content: space-between; width: 100%; padding: 0 0 8px; }
.audio-heading h2 { margin: 0 0 4px; font-size: 17px; color: #FFFFFF; }
.audio-heading p { margin: 0; max-width: 620px; color: #B8B8B8; font-size: 12px; }
.audio-heading button { flex: 0 0 auto; margin-left: 12px; }
.audio-toolbar { display: flex; align-items: center; width: 100%; height: 36px; margin: 4px 0 8px; }
.audio-search { flex: 1; max-width: 380px; height: 34px; margin-right: 10px; }
.audio-count { color: #858585; font-size: 10px; }
.audio-grid { display: flex; flex-wrap: wrap; width: 100%; padding: 4px 0 12px; }
.audio-card { display: flex; flex-direction: column; width: 236px; min-height: 160px; margin: 0 8px 8px 0; padding: 8px; border: 1px #FFFFFF20; border-radius: 6px; background-color: #1C1C1C; }
.audio-card-header { display: flex; align-items: center; width: 100%; margin-bottom: 4px; }
.audio-card-header .audio-name { flex: 1; min-width: 0; font-size: 12px; color: #FFFFFF; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.audio-kind { flex: 0 0 auto; margin-left: 6px; padding: 1px 6px; background-color: #FFFFFF10; border-radius: 4px; color: #B8B8B8; font-size: 9px; }
.audio-meta { display: block; margin-bottom: 6px; color: #858585; font-size: 9px; line-height: 1.4; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.audio-missing { color: #FFFFFF; }
.audio-inline { display: flex; align-items: center; width: 100%; height: 26px; margin-bottom: 2px; color: #B8B8B8; font-size: 10px; }
.audio-inline input[type=range] { flex: 1; height: 18px; margin-left: 6px; padding: 0; }
.audio-inline input[type=checkbox] { width: 14px; height: 14px; margin-left: 6px; }
.audio-inline select { flex: 1; height: 24px; margin-left: 6px; padding: 1px 4px; font-size: 10px; }
.audio-actions { display: flex; flex-wrap: wrap; width: 100%; margin-top: auto; padding-top: 4px; gap: 4px; }
.audio-actions button { height: 28px; margin: 0; padding: 2px 6px; font-size: 10px; }
.audio-actions button img { width: 12px; height: 12px; margin-right: 4px; }
.audio-empty { width: 100%; padding: 12px; border: 1px #FFFFFF20; background-color: #1C1C1C; color: #B8B8B8; font-size: 11px; }
.music-panel { width: 100%; margin: 2px 0 12px; padding: 10px 12px; border: 1px #FFFFFF20; border-radius: 6px; background-color: #1C1C1C; }
.music-panel h3 { margin: 0 0 4px; font-size: 13px; color: #FFFFFF; }
.music-panel p { margin: 0 0 8px; font-size: 10px; color: #B8B8B8; }
.music-grid { display: flex; flex-wrap: wrap; width: 100%; }
.music-field { display: flex; align-items: center; justify-content: space-between; width: 48%; min-width: 260px; height: 32px; margin: 0 2% 4px 0; color: #B8B8B8; font-size: 11px; }
.music-field span { flex: 0 0 auto; margin-right: 8px; color: #B8B8B8; }
.music-field select { flex: 1; min-width: 0; height: 28px; font-size: 11px; }
.music-field input[type=range] { flex: 1; min-width: 80px; height: 20px; padding: 0; }
.music-field input[type=checkbox] { width: 14px; height: 14px; }
.playlist { width: 100%; margin-top: 8px; border-top: 1px #FFFFFF20; padding-top: 6px; }
.playlist-heading { display: flex; align-items: center; justify-content: space-between; width: 100%; height: 26px; margin-bottom: 4px; font-size: 11px; color: #B8B8B8; }
.playlist-heading span { color: #858585; font-size: 10px; }
.playlist-row { display: flex; align-items: center; width: 100%; height: 30px; border-bottom: 1px #FFFFFF10; font-size: 11px; color: #FFFFFF; }
.playlist-index { flex: 0 0 24px; color: #858585; font-size: 10px; }
.playlist-track { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.playlist-track.invalid { color: #FFFFFF; }
.playlist-actions { display: flex; flex: 0 0 auto; align-items: center; }
.playlist-actions button { width: 28px; height: 26px; margin-left: 2px; padding: 0; font-size: 10px; }
.playlist-actions button img { width: 12px; height: 12px; margin: 0; }
.playlist-empty { padding: 8px 0; color: #858585; font-size: 10px; }
.playlist-clear { margin-top: 8px; }
.compact .audio-card { width: 220px; }
.compact .music-field { width: 100%; margin-right: 0; }

.tree-row.service-root { border-top: 1px #FFFFFF20; margin-top: 4px; }
