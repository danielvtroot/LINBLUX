/* Generated shared LINBLUX theme. */
button:hover { background-color: #FFFFFF12; border-color: #FFFFFF; }
button:active, button.active, select option:hover, select option:checked { background-color: #FFFFFF26; border-color: #FFFFFF; }
button.primary, .experience-primary { background-color: #FFFFFF; border-color: #FFFFFF; }
button:focus, input:focus, textarea:focus, select:focus { border-color: #FFFFFF; }
.image-option:hover { background-color: #FFFFFF12; border-color: #FFFFFF; }
.image-option.selected, #advanced-tabs button.active { background-color: #FFFFFF26; border-color: #FFFFFF; }
#header, #tabs, #ribbon, #status { background-color: #0B0B0B; }
.panel, #dialog, #context-menu { background-color: #141414CC; border-color: #FFFFFF20; }
.panel-heading, .document-tab, .group-name { background-color: #1C1C1C; }
input[type=checkbox]:checked { background-color: #FFFFFF; decorator: none; }
.tree-row.selected, .tree-row:hover, .document-tab.active, #tabs button.active { background-color: #FFFFFF26; border-color: #FFFFFF; }
#game-topbar .logo-button, #game-capsule { border-radius: 8px; background-color: #141414CC; }
.pause-panel { background-color: #141414CC; border-color: #FFFFFF20; }
.pause-tabs button.active { border-color: #FFFFFF; }
.pause-tabs button { border-radius: 6px; }
#game-topbar button { border-radius: 7px; }
.group-tools button.active { background-color: #FFFFFF26; border-color: #FFFFFF; }
.group-tools button:hover, #experience-file-menu button:hover { background-color: #FFFFFF12; border-color: #FFFFFF; }
.group-tools button { width: auto; min-width: 44px; flex: 0 0 auto; padding: 0 10px; height: 36px; }
.compact .group-tools button { width: auto; min-width: 40px; padding: 0 8px; height: 32px; }
