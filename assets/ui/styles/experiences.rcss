/* LINBLUX Experiences — home, biblioteca, detalhes. Monocromático.
   Apenas a interface oficial: cores de itens/imagens do usuário são preservadas. */
#experience-root { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 120; pointer-events: none; }
#experience-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; }
#experience-menu { display: none; height: 28px; padding: 4px 10px; margin: 0 8px; font-size: 11px; color: #B8B8B8; }
.experience-exclusive #header, .experience-exclusive #tabs, .experience-exclusive #ribbon,
.experience-exclusive #toolbox, .experience-exclusive #explorer, .experience-exclusive #properties,
.experience-exclusive #viewport-label, .experience-exclusive #advanced, .experience-exclusive #status,
.experience-exclusive #game-layer, .experience-exclusive #left-divider, .experience-exclusive #right-divider,
.experience-exclusive #property-divider, .experience-exclusive #bottom-divider, .experience-exclusive #tooltip { display: none; }
#experience-home { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: #0B0B0B; pointer-events: auto; }
.experience-sidebar { position: absolute; left: 0; top: 0; bottom: 0; width: 216px; padding: 16px 12px; border-right: 1px #FFFFFF10; background: #141414; }
.experience-brand { display: flex; align-items: center; height: 52px; padding: 0 4px; margin-bottom: 18px; }
.experience-brand img { width: 28px; height: 28px; margin-right: 10px; }
.experience-brand b { font-size: 16px; letter-spacing: 0.5px; color: #FFFFFF; }
.experience-brand small { font-size: 10px; color: #858585; margin-left: 6px; }
.experience-sidebar button { display: flex; align-items: center; width: 100%; height: 38px; margin-bottom: 4px; padding: 6px 10px; text-align: left; background: transparent; border: 1px transparent; border-radius: 6px; font-size: 12px; color: #B8B8B8; }
.experience-sidebar button img { width: 18px; height: 18px; margin-right: 10px; image-color: #B8B8B8; display: block; }
.experience-sidebar button:hover { background: #FFFFFF10; color: #FFFFFF; }
.experience-sidebar button:hover img { image-color: #FFFFFF; }
.experience-sidebar button.active { background: #FFFFFF26; border-color: #FFFFFF; color: #FFFFFF; }
.experience-sidebar button.active img { image-color: #FFFFFF; }
.experience-sidebar-rule { height: 1px; margin: 14px 4px; background: #FFFFFF10; }
.experience-primary { background: #FFFFFF; border-color: #FFFFFF; color: #0B0B0B; }
.experience-primary:hover { background: #FFFFFF; border-color: #FFFFFF; }
.experience-sidebar button.experience-primary { background: #FFFFFF; color: #0B0B0B; }
.experience-local { position: absolute; bottom: 20px; left: 18px; color: #B8B8B8; font-size: 10px; line-height: 1.5; }
.experience-local small { color: #858585; }
.experience-main { position: absolute; left: 240px; right: 0; top: 0; bottom: 0; padding: 24px 28px; overflow-y: auto; }
#experience-content { max-width: 1480px; margin: 0 auto; }
.experience-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.experience-title h1 { font-size: 26px; margin: 0 0 6px; color: #FFFFFF; }
.experience-title p { color: #B8B8B8; margin: 0; font-size: 12px; }
.experience-title button { height: 36px; padding: 0 18px; }
.experience-section { display: flex; align-items: center; justify-content: space-between; margin: 20px 0 12px; }
.experience-section h2 { font-size: 16px; margin: 0; color: #FFFFFF; }
.experience-section button { background: transparent; border: 1px #FFFFFF20; border-radius: 6px; color: #B8B8B8; font-size: 11px; padding: 2px 10px; height: 28px; }
.experience-section button:hover { background: #FFFFFF10; color: #FFFFFF; border-color: #FFFFFF40; }
.experience-grid { display: flex; flex-wrap: wrap; margin-right: -14px; }
.experience-card { width: 220px; margin: 0 14px 14px 0; border: 1px #FFFFFF20; border-radius: 8px; background: #1C1C1C; overflow: hidden; }
.experience-card:hover { border-color: #FFFFFF40; }
.experience-card { position: relative; }
.experience-cover { height: 112px; width: 100%; background: #141414; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.experience-cover img { width: 100%; height: auto; }
.experience-cover img.experience-placeholder { width: 40px; height: 40px; }
.experience-card-body { padding: 10px 12px; }
.experience-card h3 { font-size: 13px; margin: 0 0 5px; color: #FFFFFF; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.experience-card p { height: 28px; font-size: 11px; line-height: 14px; color: #B8B8B8; margin: 0 0 8px; overflow: hidden; }
.experience-card small { font-size: 9px; color: #858585; }
.experience-card-actions { display: flex; justify-content: space-between; margin-top: 8px; gap: 6px; }
.experience-card-actions button { height: 28px; padding: 2px 10px; font-size: 11px; }
.experience-template { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 160px; height: 104px; margin: 0 12px 12px 0; background: #1C1C1C; border: 1px #FFFFFF20; border-radius: 6px; }
.experience-template:hover { background: #141414; border-color: #FFFFFF40; }
.experience-template img { width: 32px; height: 32px; margin-bottom: 8px; }
.experience-template b { font-size: 12px; color: #FFFFFF; }
.experience-template small { font-size: 9px; color: #858585; margin-top: 4px; }
.experience-empty { padding: 24px; border: 1px #FFFFFF20; border-radius: 6px; color: #B8B8B8; font-size: 12px; line-height: 1.6; }
.experience-discover { display: flex; flex-wrap: wrap; }
.experience-discover button { flex: 1; min-width: 170px; margin-right: 12px; height: 64px; padding: 12px; background: #141414; border: 1px #FFFFFF20; border-radius: 6px; text-align: left; color: #FFFFFF; }
.experience-discover button:hover { background: #1C1C1C; border-color: #FFFFFF40; }
.experience-discover b { display: block; font-size: 12px; margin-bottom: 4px; color: #FFFFFF; }
.experience-discover small { display: block; color: #858585; font-size: 10px; }
.experience-form { display: flex; flex-wrap: wrap; }
.experience-fields { flex: 1; min-width: 320px; padding-right: 24px; }
.experience-media { width: 285px; padding: 0 0 0 20px; border-left: 1px #FFFFFF20; }
.experience-field { display: block; margin-bottom: 16px; }
.experience-field span { display: block; font-size: 12px; font-weight: bold; margin-bottom: 8px; color: #FFFFFF; }
.experience-field input, .experience-field select { width: 100%; height: 36px; padding: 6px 10px; border-radius: 6px; font-size: 12px; border: 1px #FFFFFF20; background: #141414; color: #FFFFFF; }
.experience-field textarea { width: 100%; height: 104px; padding: 6px 10px; font-size: 12px; border: 1px #FFFFFF20; border-radius: 6px; background: #141414; color: #FFFFFF; }
.experience-field small { display: block; color: #858585; font-size: 10px; margin-top: 6px; line-height: 1.5; }
.experience-inline { display: flex; align-items: center; margin: 0 0 16px; font-size: 11px; color: #B8B8B8; }
.experience-inline input { margin-right: 8px; }
.experience-media-block { margin-bottom: 16px; }
.experience-media-block b { display: block; font-size: 12px; margin-bottom: 6px; color: #FFFFFF; }
.experience-media-block input { width: 100%; height: 28px; font-size: 10px; margin-bottom: 6px; border: 1px #FFFFFF20; border-radius: 4px; background: #141414; color: #FFFFFF; }
.experience-media-block small { display: block; font-size: 10px; color: #858585; margin-top: 4px; }
.experience-media-block button { height: 30px; font-size: 10px; padding: 4px 10px; margin-right: 6px; }
.experience-media-preview { height: 64px; overflow: hidden; margin-bottom: 6px; background: #141414; border: 1px #FFFFFF20; border-radius: 6px; display: flex; justify-content: center; align-items: center; }
.experience-media-preview img { height: 64px; width: auto; }
.experience-form-footer { display: flex; align-items: center; justify-content: flex-end; padding: 16px 0; margin-top: 14px; border-top: 1px #FFFFFF20; gap: 8px; }
.experience-form-footer button { height: 38px; padding: 0 20px; }
.experience-detail-actions { display: flex; flex-wrap: wrap; margin-top: 14px; gap: 8px; }
.experience-detail-actions button { margin: 0; padding: 6px 14px; height: 34px; }
.experience-help { white-space: pre-wrap; font-size: 12px; line-height: 20px; color: #B8B8B8; }
#experience-error { display: none; position: absolute; right: 24px; top: 84px; width: 380px; max-height: 100px; overflow-y: auto; padding: 14px; background: #141414CC; border: 1px #FFFFFF30; border-radius: 6px; pointer-events: auto; color: #FFFFFF; }
.experience-search { display: flex; margin: 14px 0; }
.experience-search input { width: 340px; height: 34px; padding: 6px 10px; margin-right: 8px; border: 1px #FFFFFF20; border-radius: 6px; background: #141414; color: #FFFFFF; }
.experience-search button { height: 34px; padding: 0 16px; }
.experience-pagination { display: flex; align-items: center; justify-content: center; margin: 12px 0; gap: 12px; }
.experience-pagination button { height: 34px; padding: 0 16px; }
.experience-missing { padding: 12px; margin: 14px 0; border: 1px #FFFFFF20; background: #141414; border-radius: 6px; }
.experience-missing b, .experience-missing small { display: block; margin-bottom: 6px; }
.experience-missing small { color: #858585; font-size: 10px; }
.experience-missing button { height: 32px; padding: 4px 12px; margin-right: 6px; }
#experience-file-shade { display: none; position: absolute; left: 0; top: 44px; bottom: 0; right: 0; pointer-events: auto; }
#experience-file-menu { width: 340px; padding: 8px; background: #141414CC; border: 1px #FFFFFF30; border-radius: 6px; }
#experience-file-menu button { display: block; text-align: left; width: 100%; height: 34px; padding: 6px 10px; border: 1px transparent; border-radius: 6px; background: transparent; font-size: 11px; color: #FFFFFF; }
#experience-file-menu button:hover { background: #FFFFFF10; }
#experience-confirm { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: #000000BB; justify-content: center; align-items: center; pointer-events: auto; }
.experience-confirm-card { width: 500px; padding: 24px; background: #141414CC; border: 1px #FFFFFF30; border-radius: 8px; }
.experience-confirm-card h2 { font-size: 20px; margin: 0 0 14px; color: #FFFFFF; }
.experience-confirm-card p { font-size: 12px; line-height: 1.6; color: #B8B8B8; }
.experience-confirm-actions { display: flex; justify-content: flex-end; margin-top: 20px; gap: 8px; }
.experience-confirm-actions button { height: 36px; margin-left: 0; padding: 0 14px; }
#experience-loading { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: #0B0B0B; overflow: hidden; pointer-events: auto; }
#exp-loading-background { position: absolute; }
.experience-loading-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: #000000BB; }
.experience-loading-content { position: absolute; left: 10%; right: 10%; top: 25%; text-align: center; }
.experience-loading-icon { width: 100px; height: 100px; margin: 0 auto 16px; background: #141414; border: 1px #FFFFFF20; border-radius: 16px; overflow: hidden; display: flex; justify-content: center; align-items: center; }
.experience-loading-icon img { width: 94px; height: auto; }
.experience-loading-content h1 { font-size: 28px; margin: 0 0 10px; color: #FFFFFF; }
#exp-loading-title { max-height: 96px; overflow: hidden; color: #FFFFFF; }
#exp-loading-description { max-height: 66px; overflow: hidden; color: #B8B8B8; }
.experience-loading-content p { color: #B8B8B8; font-size: 13px; line-height: 1.6; margin: 0 auto 14px; max-width: 560px; }
.experience-loading-content button { height: 36px; padding: 0 20px; margin-top: 14px; }
.experience-spinner { width: 32px; height: 4px; background: #FFFFFF40; border-radius: 2px; margin: 20px auto 14px; }

/* ==========================================================================
   Home: launcher sobre fundo escuro discreto.
   ========================================================================== */
#experience-home { background: #0B0B0B; }
.home-header { position: absolute; left: 32px; right: 32px; top: 14px; height: 56px; max-width: 1180px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
.home-header .experience-brand { height: auto; margin: 0; padding: 0; }
.home-header .experience-brand img { width: 36px; height: 36px; margin-right: 12px; }
.home-header .experience-brand b { font-size: 17px; letter-spacing: 1px; color: #FFFFFF; }
.home-header .experience-brand small { margin-left: 8px; font-size: 10px; letter-spacing: 1px; color: #858585; }
.home-navigation { display: flex; align-items: center; }
.home-navigation button { height: 34px; margin-left: 4px; padding: 0 14px; background: #141414CC; border: 1px #FFFFFF20; border-radius: 18px; color: #B8B8B8; font-size: 12px; }
.home-navigation button:hover { background: #FFFFFF10; border-color: #FFFFFF40; color: #FFFFFF; }
.home-navigation button.active { background: #FFFFFF26; border-color: #FFFFFF; color: #FFFFFF; }
.experience-main { left: 0; right: 0; top: 84px; padding: 0 32px 24px; }
.experience-compact .experience-main { padding: 0 32px 24px; }
#experience-content { max-width: 1140px; }

/* Hero */
.home-intro { padding: 14px 0 20px; }
.home-intro small { font-size: 11px; letter-spacing: 2px; color: #858585; }
.home-intro h1 { font-size: 32px; line-height: 1.12; margin: 8px 0 8px; color: #FFFFFF; }
.home-intro p { font-size: 14px; line-height: 1.5; color: #B8B8B8; margin: 0 0 18px; }
.home-actions { display: flex; gap: 8px; }
.home-actions button, .home-navigation button, .home-default-actions button { display: block; flex-shrink: 0; white-space: nowrap; }
.home-actions button { min-width: 170px; height: 40px; line-height: 38px; margin: 0; padding: 0 20px; font-size: 13px; border-radius: 8px; background: #141414CC; border: 1px #FFFFFF20; color: #FFFFFF; }
.home-actions button:hover { background: #FFFFFF10; border-color: #FFFFFF40; }
.home-actions .experience-primary { background: #FFFFFF; border-color: #FFFFFF; color: #0B0B0B; font-weight: bold; }
.home-actions .experience-primary:hover { background: #FFFFFF; border-color: #FFFFFF; }
.home-actions .experience-primary:active { background: #FFFFFF; border-color: #FFFFFF; }

/* Mundo padrão */
.home-default-card { display: flex; align-items: center; margin: 0 0 16px; padding: 12px 16px; background: #141414CC; border: 1px #FFFFFF20; border-radius: 10px; }
.home-default-icon { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: 0 0 40px; margin-right: 12px; background: #1C1C1C; border: 1px #FFFFFF20; border-radius: 8px; }
.home-default-icon img { width: 24px; height: 24px; margin: 0; }
.home-default-copy { flex: 1; min-width: 0; }
.home-default-copy h2 { font-size: 15px; margin: 0 0 3px; color: #FFFFFF; }
.home-default-copy p { font-size: 12px; line-height: 16px; color: #B8B8B8; margin: 0 0 4px; }
.home-default-copy small { font-size: 9px; letter-spacing: 1px; color: #858585; }
.home-default-actions { flex: 0 0 auto; margin-left: 14px; }
.home-default-actions button { height: 36px; padding: 0 16px; border-radius: 8px; background: #1C1C1C; border: 1px #FFFFFF30; color: #FFFFFF; }
.home-default-actions button:hover { background: #FFFFFF10; border-color: #FFFFFF40; }

/* Seções */
.experience-section { display: flex; align-items: center; justify-content: space-between; margin: 0 0 10px; }
.experience-section-title { display: flex; align-items: center; }
.experience-section h2 { font-size: 15px; margin: 0; color: #FFFFFF; }
.experience-section-count { height: 20px; margin-left: 8px; padding: 1px 6px; background: #FFFFFF10; border: 1px #FFFFFF20; border-radius: 10px; color: #858585; font-size: 10px; line-height: 14px; }
.experience-section > button { height: 28px; padding: 0 10px; background: transparent; border: 1px #FFFFFF20; border-radius: 6px; color: #B8B8B8; font-size: 12px; }
.experience-section > button:hover { background: #FFFFFF10; color: #FFFFFF; border-color: #FFFFFF40; }

/* Experiências recentes (linhas compactas) */
.home-recent { display: flex; flex-wrap: wrap; margin: 0 -8px 0 0; }
.home-recent .experience-card { display: flex; align-items: center; flex: 1 1 520px; width: auto; min-width: 0; max-width: 100%; margin: 0 8px 8px 0; padding: 10px; background: #141414CC; border: 1px #FFFFFF20; border-radius: 10px; overflow: visible; }
.home-recent .experience-card:hover { background: #1C1C1C; border-color: #FFFFFF40; }
.home-recent .experience-cover { width: 116px; height: 70px; flex: 0 0 116px; margin-right: 12px; background: #1C1C1C; border: 1px #FFFFFF20; border-radius: 8px; }
.home-recent .experience-cover img { width: 100%; height: auto; }
.home-recent .experience-cover img.experience-placeholder { width: 32px; height: 32px; }
.home-recent .experience-card-body { flex: 1 1 auto; min-width: 0; padding: 0; }
.home-recent .experience-card h3 { font-size: 14px; margin: 0 0 4px; color: #FFFFFF; }
.home-recent .experience-card p { height: auto; max-height: 30px; font-size: 11px; line-height: 15px; color: #B8B8B8; margin: 0 0 6px; overflow: hidden; }
.experience-card-meta { display: flex; align-items: center; }
.home-recent .experience-card small { font-size: 10px; color: #858585; }
.experience-card-dot { width: 3px; height: 3px; margin: 0 6px; border-radius: 2px; background: #858585; }
.home-recent .experience-card-actions { display: flex; align-items: center; justify-content: flex-end; width: 116px; flex: 0 0 116px; margin: 0 0 0 12px; }
.home-recent .experience-card-actions button { display: block; height: 34px; line-height: 32px; margin: 0; padding: 0 12px; border-radius: 8px; font-size: 12px; white-space: nowrap; }
.home-recent .experience-card-actions button.experience-primary { width: 76px; flex: 0 0 76px; font-weight: bold; }
.home-recent .experience-card-actions .experience-primary { min-width: 76px; background: #FFFFFF; border-color: #FFFFFF; color: #0B0B0B; }
.home-recent .experience-card-actions .experience-primary:hover { background: #FFFFFF; border-color: #FFFFFF; }
.home-recent .experience-card-actions .experience-primary:active { background: #FFFFFF; border-color: #FFFFFF; }
.home-recent .experience-card-actions .experience-primary:focus { border-color: #FFFFFF; }

/* Botão "..." do card */
.experience-card-actions .experience-more { width: 34px; min-width: 34px; padding: 0; background: #1C1C1C; border: 1px #FFFFFF20; border-radius: 8px; color: #B8B8B8; font-size: 16px; line-height: 32px; text-align: center; }
.home-recent .experience-card-actions button.experience-more { width: 34px; height: 34px; flex: 0 0 34px; padding: 0; margin-left: 6px; line-height: 32px; }
.experience-card-actions .experience-more:hover { background: #FFFFFF10; border-color: #FFFFFF40; color: #FFFFFF; }
.experience-card-actions .experience-more.active, .experience-card-actions .experience-more:active { background: #FFFFFF26; border-color: #FFFFFF; color: #FFFFFF; }

/* Menu flutuante do card */
.experience-card-menu { position: absolute; right: 8px; bottom: 44px; width: 220px; padding: 4px; background: #141414EE; border: 1px #FFFFFF30; border-radius: 8px; z-index: 8; }
.experience-card.menu-open { z-index: 4; overflow: visible; }
.home-recent .experience-card-menu { top: 70px; bottom: auto; right: 10px; }
.experience-card-menu button { display: block; width: 100%; height: 34px; line-height: 32px; padding: 0 10px; background: transparent; border: 1px transparent; border-radius: 6px; color: #FFFFFF; font-size: 12px; text-align: left; white-space: nowrap; }
.experience-card-menu button:hover { background: #FFFFFF10; }
.experience-card-menu button:active { background: #FFFFFF26; }
.experience-card-menu button:focus { border-color: #FFFFFF; }
.experience-card-menu button.experience-menu-danger { color: #FFFFFF; }
.experience-card-menu button.experience-menu-danger:hover { background: #FFFFFF10; color: #FFFFFF; }
.experience-menu-rule { height: 1px; margin: 4px 6px; background: #FFFFFF20; }

/* Cards, formulários e diálogos compartilhados (biblioteca, arquivo, configurações). */
.experience-card { width: 244px; background: #141414CC; border: 1px #FFFFFF20; border-radius: 8px; }
.experience-card:hover { border-color: #FFFFFF40; background: #1C1C1C; }
.experience-card h3 { font-size: 14px; color: #FFFFFF; }
.experience-card p { font-size: 11px; color: #B8B8B8; }
.experience-card-actions button { height: 34px; font-size: 11px; }
.experience-empty { width: 100%; padding: 24px; background: #1414148c; border: 0; border-radius: 6px; font-size: 14px; color: #B8B8B8; }
.experience-form, .experience-title { padding: 20px; background: #141414D9; border-radius: 6px; }
.experience-confirm-card { background: #141414CC; border-color: #FFFFFF20; }
.experience-loading-shade { background: #000000BB; }
.experience-settings { padding: 24px; background: #151519E0; border-radius: 6px; }
.experience-settings button { display: block; width: 420px; max-width: 100%; height: 40px; margin-bottom: 10px; text-align: left; }
#exp-header-default-save { height: 28px; padding: 2px 10px; font-size: 11px; margin: 0 8px; }
#experience-form-actions { display: none; position: absolute; left: 0; right: 0; bottom: 0; height: 72px; padding: 14px 5%; margin: 0; background: #141414F2; border-top: 1px #FFFFFF20; }
#experience-form-actions button { height: 44px; padding: 0 24px; font-size: 14px; }
