/* LINBLUX Experiences — identidade monocromática.
   Geometria preservada; cores migradas para paleta branco/preto. */
#experience-root { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 120; pointer-events: none; }
#experience-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; }
#experience-menu { display: none; height: 25px; padding: 3px 10px; margin: 0 8px; font-size: 11px; }
.experience-exclusive #header, .experience-exclusive #tabs, .experience-exclusive #ribbon,
.experience-exclusive #toolbox, .experience-exclusive #explorer, .experience-exclusive #properties,
.experience-exclusive #viewport-label, .experience-exclusive #advanced, .experience-exclusive #status,
.experience-exclusive #game-layer, .experience-exclusive #left-divider, .experience-exclusive #right-divider,
.experience-exclusive #property-divider, .experience-exclusive #bottom-divider, .experience-exclusive #tooltip { display: none; }
#experience-home { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: #0B0B0B; pointer-events: auto; }
.experience-sidebar { position: absolute; left: 0; top: 0; bottom: 0; width: 204px; padding: 18px 12px; border-right: 1px #FFFFFF15; background: #141414; }
.experience-brand { display: flex; align-items: center; height: 62px; padding: 0 5px; margin-bottom: 20px; }
.experience-brand img { width: 31px; height: 31px; margin-right: 9px; }
.experience-brand b { font-size: 17px; letter-spacing: 1px; }
.experience-brand small { font-size: 9px; color: #858585; margin-left: 5px; }
.experience-sidebar button { display: flex; align-items: center; width: 100%; height: 39px; margin-bottom: 5px; padding: 8px 10px; text-align: left; background: transparent; border: 1px transparent; border-radius: 5px; font-size: 12px; }
.experience-sidebar button img { width: 18px; height: 18px; margin-right: 11px; }
.experience-sidebar button.active { background: #FFFFFF26; border-color: #FFFFFF; }
.experience-sidebar button:hover { background: #FFFFFF12; }
.experience-sidebar-rule { height: 1px; margin: 16px 4px; background: #FFFFFF15; }
.experience-primary { background: #FFFFFF; border-color: #FFFFFF; color: #0B0B0B; }
.experience-primary:hover { background: #E0E0E0; }
.experience-sidebar button.experience-primary { background: #FFFFFF; color: #0B0B0B; }
.experience-local { position: absolute; bottom: 23px; left: 22px; color: #B8B8B8; font-size: 10px; line-height: 19px; }
.experience-local small { color: #858585; }
.experience-main { position: absolute; left: 228px; right: 0; top: 0; bottom: 0; padding: 27px 30px; overflow-y: auto; }
#experience-content { max-width: 1530px; margin: 0 auto; }
.experience-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
.experience-title h1 { font-size: 25px; margin: 0 0 7px; }
.experience-title p { color: #B8B8B8; margin: 0; font-size: 12px; }
.experience-title button { height: 34px; padding: 7px 17px; }
.experience-section { display: flex; align-items: center; justify-content: space-between; margin: 24px 0 13px; }
.experience-section h2 { font-size: 17px; margin: 0; }
.experience-section button { background: transparent; border-color: transparent; color: #B8B8B8; font-size: 11px; }
.experience-grid { display: flex; flex-wrap: wrap; margin-right: -16px; }
.experience-card { width: 216px; margin: 0 16px 16px 0; border: 1px #FFFFFF22; border-radius: 7px; background: #1C1C1C; overflow: hidden; }
.experience-card:hover { border-color: #FFFFFF40; }
.experience-card { position: relative; }
.experience-cover { height: 121px; width: 100%; background: #252525; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.experience-cover img { width: 100%; height: auto; }
.experience-cover img.experience-placeholder { width: 43px; height: 43px; }
.experience-card-body { padding: 11px 12px; }
.experience-card h3 { font-size: 13px; margin: 0 0 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.experience-card p { height: 29px; font-size: 10px; line-height: 14px; color: #B8B8B8; margin: 0 0 8px; overflow: hidden; }
.experience-card small { font-size: 9px; color: #858585; }
.experience-card-actions { display: flex; justify-content: space-between; margin-top: 9px; }
.experience-card-actions button { height: 26px; padding: 3px 11px; font-size: 11px; }
.experience-template { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 166px; height: 112px; margin: 0 14px 14px 0; background: #1C1C1C; border: 1px #FFFFFF22; border-radius: 6px; }
.experience-template:hover { background: #252525; border-color: #FFFFFF40; }
.experience-template img { width: 35px; height: 35px; margin-bottom: 10px; }
.experience-template b { font-size: 12px; }
.experience-template small { font-size: 9px; color: #858585; margin-top: 5px; }
.experience-empty { padding: 24px; border: 1px #FFFFFF15; border-radius: 6px; color: #858585; font-size: 12px; line-height: 22px; }
.experience-discover { display: flex; flex-wrap: wrap; }
.experience-discover button { flex: 1; min-width: 170px; margin-right: 14px; height: 70px; padding: 14px; background: #1C1C1C; text-align: left; }
.experience-discover b { display: block; font-size: 12px; margin-bottom: 5px; }
.experience-discover small { display: block; color: #858585; font-size: 10px; }
.experience-form { display: flex; flex-wrap: wrap; }
.experience-fields { flex: 1; min-width: 320px; padding-right: 27px; }
.experience-media { width: 285px; padding: 0 0 0 22px; border-left: 1px #FFFFFF15; }
.experience-field { display: block; margin-bottom: 17px; }
.experience-field span { display: block; font-size: 12px; font-weight: bold; margin-bottom: 8px; }
.experience-field input, .experience-field select { width: 100%; height: 34px; padding: 7px 9px; border-radius: 4px; font-size: 12px; }
.experience-field textarea { width: 100%; height: 104px; padding: 8px 9px; font-size: 12px; }
.experience-field small { display: block; color: #858585; font-size: 10px; margin-top: 6px; line-height: 16px; }
.experience-inline { display: flex; align-items: center; margin: 0 0 18px; font-size: 11px; }
.experience-inline input { margin-right: 9px; }
.experience-media-block { margin-bottom: 18px; }
.experience-media-block b { display: block; font-size: 12px; margin-bottom: 7px; }
.experience-media-block input { width: 100%; height: 28px; font-size: 10px; margin-bottom: 6px; }
.experience-media-block small { display: block; font-size: 10px; color: #858585; margin-top: 5px; }
.experience-media-block button { height: 28px; font-size: 10px; padding: 4px 10px; margin-right: 7px; }
.experience-media-preview { height: 68px; overflow: hidden; margin-bottom: 7px; background: #252525; display: flex; justify-content: center; align-items: center; }
.experience-media-preview img { height: 68px; width: auto; }
.experience-form-footer { display: flex; align-items: center; justify-content: flex-end; padding: 19px 0; margin-top: 16px; border-top: 1px #FFFFFF15; }
.experience-form-footer button { height: 36px; padding: 8px 22px; margin-left: 11px; }
.experience-detail-actions { display: flex; flex-wrap: wrap; margin-top: 15px; }
.experience-detail-actions button { margin: 0 9px 9px 0; padding: 7px 13px; height: 32px; }
.experience-help { white-space: pre-wrap; font-size: 12px; line-height: 20px; color: #B8B8B8; }
#experience-error { display: none; position: absolute; right: 25px; top: 83px; width: 390px; max-height: 100px; overflow-y: auto; padding: 13px; background: #2A2A2A; border: 1px #FFFFFF40; border-radius: 5px; pointer-events: auto; }
.experience-search { display: flex; margin: 14px 0; }
.experience-search input { width: 340px; height: 32px; padding: 6px 9px; margin-right: 8px; }
.experience-search button { height: 32px; padding: 6px 14px; }
.experience-pagination { display: flex; align-items: center; justify-content: center; margin: 12px 0; }
.experience-pagination button { height: 32px; padding: 6px 14px; margin: 0 15px; }
.experience-missing { padding: 12px; margin: 15px 0; border: 1px #FFFFFF22; background: #1C1C1C; }
.experience-missing b, .experience-missing small { display: block; margin-bottom: 7px; }
.experience-missing small { color: #858585; font-size: 10px; }
.experience-missing button { height: 30px; padding: 6px 12px; margin-right: 8px; }
#experience-file-shade { display: none; position: absolute; left: 0; top: 34px; bottom: 0; right: 0; pointer-events: auto; }
#experience-file-menu { width: 335px; padding: 8px; background: #1A1A1A; border: 1px #FFFFFF30; border-radius: 4px; }
#experience-file-menu button { display: block; text-align: left; width: 100%; height: 33px; padding: 8px 10px; border: 0px; background: transparent; font-size: 11px; }
#experience-file-menu button:hover { background: #FFFFFF15; }
#experience-confirm { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: #000000BD; justify-content: center; align-items: center; pointer-events: auto; }
.experience-confirm-card { width: 510px; padding: 27px; background: #1A1A1A; border: 1px #FFFFFF22; border-radius: 8px; }
.experience-confirm-card h2 { font-size: 20px; margin: 0 0 16px; }
.experience-confirm-card p { font-size: 12px; line-height: 21px; color: #B8B8B8; }
.experience-confirm-actions { display: flex; justify-content: flex-end; margin-top: 23px; }
.experience-confirm-actions button { height: 34px; margin-left: 9px; padding: 6px 13px; }
#experience-loading { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: #0B0B0B; overflow: hidden; pointer-events: auto; }
#exp-loading-background { position: absolute; }
.experience-loading-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: #000000AD; }
.experience-loading-content { position: absolute; left: 10%; right: 10%; top: 23%; text-align: center; }
.experience-loading-icon { width: 116px; height: 116px; margin: 0 auto 20px; background: #202020; border: 1px #FFFFFF22; border-radius: 18px; overflow: hidden; display: flex; justify-content: center; align-items: center; }
.experience-loading-icon img { width: 108px; height: auto; }
.experience-loading-content h1 { font-size: 29px; margin: 0 0 12px; }
#exp-loading-title { max-height: 96px; overflow: hidden; }
#exp-loading-description { max-height: 66px; overflow: hidden; }
.experience-loading-content p { color: #B8B8B8; font-size: 13px; line-height: 22px; margin: 0 auto 15px; max-width: 560px; }
.experience-loading-content button { height: 34px; padding: 6px 19px; margin-top: 17px; }
.experience-spinner { width: 35px; height: 5px; background: #FFFFFF; border-radius: 3px; margin: 25px auto 15px; animation: 0.8s alternate infinite experience-pulse; }
@keyframes experience-pulse { from { opacity: 0.25; transform: scaleX(0.5); } to { opacity: 1; transform: scaleX(1.4); } }
.experience-compact .experience-media { width: 240px; }
.experience-compact .experience-main { padding: 23px; }

/* ==========================================================================
   Home: launcher surface over the full-window video.
   ========================================================================== */
#experience-home { background: transparent; }

.home-header { position: absolute; left: 32px; right: 32px; top: 14px; height: 56px; max-width: 1180px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
.home-header .experience-brand { height: auto; margin: 0; padding: 0; }
.home-header .experience-brand img { width: 40px; height: 40px; margin-right: 12px; }
.home-header .experience-brand b { font-size: 18px; letter-spacing: 2.5px; }
.home-header .experience-brand small { margin-left: 9px; font-size: 10px; letter-spacing: 1.6px; color: #858585; }

.home-navigation { display: flex; align-items: center; }
.home-navigation button { height: 32px; margin-left: 4px; padding: 0 14px; background: #FFFFFF0D; border: 1px #FFFFFF12; border-radius: 16px; color: #B8B8B8; font-size: 12px; }
.home-navigation button:hover { background: #FFFFFF1A; border-color: #FFFFFF30; color: #FFFFFF; }
.home-navigation button.active { background: #FFFFFF26; border-color: #FFFFFF; color: #FFFFFF; }

.experience-main { left: 0; right: 0; top: 88px; padding: 0 32px 28px; }
.experience-compact .experience-main { padding: 0 32px 28px; }
#experience-content { max-width: 1180px; }

/* Hero */
.home-intro { padding: 16px 0 22px; }
.home-intro small { font-size: 11px; letter-spacing: 3px; color: #858585; }
.home-intro h1 { font-size: 34px; line-height: 1.12; margin: 10px 0 8px; }
.home-intro p { font-size: 14px; line-height: 1.5; color: #B8B8B8; margin: 0 0 18px; }
.home-actions { display: flex; }
.home-actions button, .home-navigation button, .home-default-actions button { display: block; flex-shrink: 0; white-space: nowrap; }
.home-navigation button { line-height: 30px; }
.home-default-actions button { line-height: 32px; }
.home-actions button { min-width: 176px; height: 40px; line-height: 38px; margin: 0 10px 0 0; padding: 0 20px; font-size: 13px; border-radius: 8px; background: #FFFFFF12; border: 1px #FFFFFF22; color: #FFFFFF; }
.home-actions button:hover { background: #FFFFFF1A; border-color: #FFFFFF40; color: #FFFFFF; }
.home-actions .experience-primary { background: #FFFFFF; border-color: #FFFFFF; color: #0B0B0B; }
.home-actions .experience-primary:hover { background: #E0E0E0; border-color: #E0E0E0; }
.home-actions .experience-primary:active { background: #C8C8C8; border-color: #C8C8C8; }

/* Engine default world */
.home-default-card { display: flex; align-items: center; margin: 0 0 18px; padding: 13px 16px; background: #141414B3; border: 1px #FFFFFF15; border-radius: 10px; }
.home-default-icon { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex: 0 0 44px; margin-right: 14px; background: #202020; border: 1px #FFFFFF15; border-radius: 10px; }
.home-default-icon img { width: 26px; height: 26px; margin: 0; }
.home-default-copy { flex: 1; min-width: 0; }
.home-default-copy h2 { font-size: 15px; margin: 0 0 3px; }
.home-default-copy p { font-size: 12px; line-height: 16px; color: #B8B8B8; margin: 0 0 4px; }
.home-default-copy small { font-size: 9px; letter-spacing: 1.1px; color: #858585; }
.home-default-actions { flex: 0 0 auto; margin-left: 16px; }
.home-default-actions button { height: 34px; padding: 0 16px; border-radius: 7px; background: #FFFFFF12; border: 1px #FFFFFF22; color: #FFFFFF; }
.home-default-actions button:hover { background: #FFFFFF20; border-color: #FFFFFF40; color: #FFFFFF; }

/* Section headings */
.experience-section { display: flex; align-items: center; justify-content: space-between; margin: 0 0 10px; }
.experience-section-title { display: flex; align-items: center; }
.experience-section h2 { font-size: 15px; margin: 0; }
.experience-section-count { height: 18px; margin-left: 8px; padding: 1px 6px; background: #FFFFFF0F; border: 1px #FFFFFF15; border-radius: 9px; color: #858585; font-size: 10px; line-height: 14px; }
.experience-section > button { height: 26px; padding: 0 10px; background: transparent; border: 0px; border-radius: 6px; color: #B8B8B8; font-size: 12px; }
.experience-section > button:hover { background: #FFFFFF12; color: #FFFFFF; }

/* Recent experiences */
.home-recent { display: flex; flex-wrap: wrap; margin: 0 -10px 0 0; }
.home-recent .experience-card { display: flex; align-items: center; flex: 1 1 520px; width: auto; min-width: 0; max-width: 100%; margin: 0 10px 10px 0; padding: 12px; background: #141414C9; border: 1px #FFFFFF12; border-radius: 10px; overflow: visible; }
.home-recent .experience-card:hover { background: #1C1C1CE0; border-color: #FFFFFF30; }
.home-recent .experience-cover { width: 132px; height: 78px; flex: 0 0 132px; margin-right: 14px; background: #202020; border: 1px #FFFFFF0F; border-radius: 8px; }
.home-recent .experience-cover img { width: 100%; height: auto; }
.home-recent .experience-cover img.experience-placeholder { width: 34px; height: 34px; }
.home-recent .experience-card-body { flex: 1 1 auto; min-width: 0; padding: 0; }
.home-recent .experience-card h3 { font-size: 15px; margin: 0 0 5px; }
.home-recent .experience-card p { height: auto; max-height: 32px; font-size: 12px; line-height: 16px; color: #B8B8B8; margin: 0 0 6px; overflow: hidden; }
.experience-card-meta { display: flex; align-items: center; }
.home-recent .experience-card small { font-size: 10px; color: #858585; }
.experience-card-dot { width: 3px; height: 3px; margin: 0 6px; border-radius: 2px; background: #FFFFFF30; }
.home-recent .experience-card-actions { display: flex; align-items: center; justify-content: flex-end; width: 122px; flex: 0 0 122px; margin: 0 0 0 14px; }
.home-recent .experience-card-actions button { display: block; height: 34px; line-height: 32px; margin: 0; padding: 0 12px; border-radius: 7px; font-size: 12px; white-space: nowrap; }
.home-recent .experience-card-actions button.experience-primary { width: 80px; flex: 0 0 80px; }
.home-recent .experience-card-actions .experience-primary { min-width: 80px; background: #FFFFFF; border: 1px #FFFFFF; color: #0B0B0B; font-weight: bold; }
.home-recent .experience-card-actions .experience-primary:hover { background: #E0E0E0; border-color: #E0E0E0; }
.home-recent .experience-card-actions .experience-primary:active { background: #C8C8C8; border-color: #C8C8C8; }
.home-recent .experience-card-actions .experience-primary:focus { border-color: #FFFFFF; }

.experience-card-actions .experience-more { width: 34px; min-width: 34px; padding: 0; background: #1C1C1C; border: 1px #FFFFFF15; border-radius: 7px; color: #B8B8B8; font-size: 16px; line-height: 30px; text-align: center; }
.home-recent .experience-card-actions button.experience-more { width: 34px; height: 34px; flex: 0 0 34px; padding: 0; margin-left: 8px; line-height: 30px; }
.experience-card-actions .experience-more:hover { background: #252525; border-color: #FFFFFF30; color: #FFFFFF; }
.experience-card-actions .experience-more.active, .experience-card-actions .experience-more:active { background: #FFFFFF26; border-color: #FFFFFF; color: #FFFFFF; }

.experience-card-menu { position: absolute; right: 8px; bottom: 46px; width: 216px; padding: 5px; background: #1A1A1AFA; border: 1px #FFFFFF25; border-radius: 10px; z-index: 8; }
.experience-card.menu-open { z-index: 4; overflow: visible; }
.home-recent .experience-card-menu { top: 76px; bottom: auto; right: 12px; }
.experience-card-menu button { display: block; width: 100%; height: 32px; line-height: 30px; padding: 0 10px; background: transparent; border: 1px transparent; border-radius: 5px; color: #FFFFFF; font-size: 12px; text-align: left; white-space: nowrap; }
.experience-card-menu button:hover { background: #FFFFFF12; }
.experience-card-menu button:active { background: #FFFFFF20; }
.experience-card-menu button:focus { border-color: #FFFFFF; }
.experience-card-menu button.experience-menu-danger { color: #FFFFFF80; }
.experience-card-menu button.experience-menu-danger:hover { background: #FFFFFF12; color: #FFFFFF; }
.experience-menu-rule { height: 1px; margin: 4px 6px; background: #FFFFFF15; }

/* Shared cards, forms and dialogs */
.experience-card { width: 240px; background: #141414C9; border: 1px #FFFFFF15; border-radius: 9px; }
.experience-card:hover { border-color: #FFFFFF30; background: #1C1C1CDF; }
.experience-card h3 { font-size: 15px; }
.experience-card p { font-size: 12px; }
.experience-card-actions button { height: 32px; font-size: 12px; }
.experience-empty { width: 100%; padding: 26px; background: #1414148C; border: 0px; border-radius: 8px; font-size: 15px; color: #B8B8B8; }
.experience-form, .experience-title { padding: 20px; background: #141414D9; border-radius: 8px; }
.experience-confirm-card { background: #1A1A1AF5; border-color: #FFFFFF22; }
.experience-loading-shade { background: #000000BD; }
.experience-spinner { background: #FFFFFF; }
.experience-settings { padding: 24px; background: #151515E0; border-radius: 8px; }
.experience-settings button { display: block; width: 420px; max-width: 100%; height: 40px; margin-bottom: 12px; text-align: left; }
#exp-header-default-save { height: 26px; padding: 3px 10px; font-size: 11px; margin: 0 8px; }
#experience-form-actions { display: none; position: absolute; left: 0; right: 0; bottom: 0; height: 76px; padding: 16px 5%; margin: 0; background: #141418F2; border-top: 1px #FFFFFF15; }
#experience-form-actions button { height: 42px; padding: 10px 22px; font-size: 14px; }
