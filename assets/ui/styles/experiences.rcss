/* LINBLUX Experiences surfaces: graphite #202227, raised #2a2d34,
   text #f1f3f7, secondary #aeb7c7, accent #377ed2; spacing 8/16/24/32. */
#experience-root { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 120; pointer-events: none; }
#experience-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; }
#experience-menu { display: none; height: 25px; padding: 3px 10px; margin: 0 8px; font-size: 11px; }
.experience-exclusive #header, .experience-exclusive #tabs, .experience-exclusive #ribbon,
.experience-exclusive #toolbox, .experience-exclusive #explorer, .experience-exclusive #properties,
.experience-exclusive #viewport-label, .experience-exclusive #advanced, .experience-exclusive #status,
.experience-exclusive #game-layer, .experience-exclusive #left-divider, .experience-exclusive #right-divider,
.experience-exclusive #property-divider, .experience-exclusive #bottom-divider, .experience-exclusive #tooltip { display: none; }
#experience-home { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: #202227; pointer-events: auto; }
.experience-sidebar { position: absolute; left: 0; top: 0; bottom: 0; width: 204px; padding: 18px 12px; border-right: 1px #363b44; background: #24272d; }
.experience-brand { display: flex; align-items: center; height: 62px; padding: 0 5px; margin-bottom: 20px; }
.experience-brand img { width: 31px; height: 31px; margin-right: 9px; }
.experience-brand b { font-size: 17px; letter-spacing: 1px; }
.experience-brand small { font-size: 9px; color: #aeb7c7; margin-left: 5px; }
.experience-sidebar button { display: flex; align-items: center; width: 100%; height: 39px; margin-bottom: 5px; padding: 8px 10px; text-align: left; background: transparent; border: 1px transparent; border-radius: 5px; font-size: 12px; }
.experience-sidebar button img { width: 18px; height: 18px; margin-right: 11px; }
.experience-sidebar button.active { background: #34465f; border-color: #4876a8; }
.experience-sidebar button:hover { background: #353b46; }
.experience-sidebar-rule { height: 1px; margin: 16px 4px; background: #414650; }
.experience-primary { background: #347cc9; border-color: #5793d6; color: #ffffff; }
.experience-primary:hover { background: #438cdc; }
.experience-sidebar button.experience-primary { background: #347cc9; }
.experience-local { position: absolute; bottom: 23px; left: 22px; color: #d0d8e5; font-size: 10px; line-height: 19px; }
.experience-local small { color: #929dad; }
.experience-main { position: absolute; left: 228px; right: 0; top: 0; bottom: 0; padding: 27px 30px; overflow-y: auto; }
#experience-content { max-width: 1530px; margin: 0 auto; }
.experience-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
.experience-title h1 { font-size: 25px; margin: 0 0 7px; }
.experience-title p { color: #aeb7c7; margin: 0; font-size: 12px; }
.experience-title button { height: 34px; padding: 7px 17px; }
.experience-section { display: flex; align-items: center; justify-content: space-between; margin: 24px 0 13px; }
.experience-section h2 { font-size: 17px; margin: 0; }
.experience-section button { background: transparent; border-color: transparent; color: #8ebbf0; font-size: 11px; }
.experience-grid { display: flex; flex-wrap: wrap; margin-right: -16px; }
.experience-card { width: 216px; margin: 0 16px 16px 0; border: 1px #424750; border-radius: 7px; background: #292c32; overflow: hidden; }
.experience-card:hover { border-color: #7b9cc6; }
.experience-card { position: relative; }
.experience-cover { height: 121px; width: 100%; background: #353c49; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.experience-cover img { width: 100%; height: auto; }
.experience-cover img.experience-placeholder { width: 43px; height: 43px; }
.experience-card-body { padding: 11px 12px; }
.experience-card h3 { font-size: 13px; margin: 0 0 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.experience-card p { height: 29px; font-size: 10px; line-height: 14px; color: #b9c2d1; margin: 0 0 8px; overflow: hidden; }
.experience-card small { font-size: 9px; color: #9aa7ba; }
.experience-card-actions { display: flex; justify-content: space-between; margin-top: 9px; }
.experience-card-actions button { height: 26px; padding: 3px 11px; font-size: 11px; }
.experience-template { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 166px; height: 112px; margin: 0 14px 14px 0; background: #2c313a; border: 1px #454c58; border-radius: 6px; }
.experience-template:hover { background: #354254; border-color: #6b9bd1; }
.experience-template img { width: 35px; height: 35px; margin-bottom: 10px; }
.experience-template b { font-size: 12px; }
.experience-template small { font-size: 9px; color: #aeb7c7; margin-top: 5px; }
.experience-empty { padding: 24px; border: 1px #424956; border-radius: 6px; color: #abb7c9; font-size: 12px; line-height: 22px; }
.experience-discover { display: flex; flex-wrap: wrap; }
.experience-discover button { flex: 1; min-width: 170px; margin-right: 14px; height: 70px; padding: 14px; background: #282d35; text-align: left; }
.experience-discover b { display: block; font-size: 12px; margin-bottom: 5px; }
.experience-discover small { display: block; color: #adb9ca; font-size: 10px; }
.experience-form { display: flex; flex-wrap: wrap; }
.experience-fields { flex: 1; min-width: 320px; padding-right: 27px; }
.experience-media { width: 285px; padding: 0 0 0 22px; border-left: 1px #424650; }
.experience-field { display: block; margin-bottom: 17px; }
.experience-field span { display: block; font-size: 12px; font-weight: bold; margin-bottom: 8px; }
.experience-field input, .experience-field select { width: 100%; height: 34px; padding: 7px 9px; border-radius: 4px; font-size: 12px; }
.experience-field textarea { width: 100%; height: 104px; padding: 8px 9px; font-size: 12px; }
.experience-field small { display: block; color: #9daabd; font-size: 10px; margin-top: 6px; line-height: 16px; }
.experience-inline { display: flex; align-items: center; margin: 0 0 18px; font-size: 11px; }
.experience-inline input { margin-right: 9px; }
.experience-media-block { margin-bottom: 18px; }
.experience-media-block b { display: block; font-size: 12px; margin-bottom: 7px; }
.experience-media-block input { width: 100%; height: 28px; font-size: 10px; margin-bottom: 6px; }
.experience-media-block small { display: block; font-size: 10px; color: #a8b5c9; margin-top: 5px; }
.experience-media-block button { height: 28px; font-size: 10px; padding: 4px 10px; margin-right: 7px; }
.experience-media-preview { height: 68px; overflow: hidden; margin-bottom: 7px; background: #303744; display: flex; justify-content: center; align-items: center; }
.experience-media-preview img { height: 68px; width: auto; }
.experience-form-footer { display: flex; align-items: center; justify-content: flex-end; padding: 19px 0; margin-top: 16px; border-top: 1px #424956; }
.experience-form-footer button { height: 36px; padding: 8px 22px; margin-left: 11px; }
.experience-detail-actions { display: flex; flex-wrap: wrap; margin-top: 15px; }
.experience-detail-actions button { margin: 0 9px 9px 0; padding: 7px 13px; height: 32px; }
.experience-help { white-space: pre-wrap; font-size: 12px; line-height: 20px; color: #d1d9e6; }
#experience-error { display: none; position: absolute; right: 25px; top: 83px; width: 390px; max-height: 100px; overflow-y: auto; padding: 13px; background: #5e3038; border: 1px #c96978; border-radius: 5px; pointer-events: auto; }
.experience-search { display: flex; margin: 14px 0; }
.experience-search input { width: 340px; height: 32px; padding: 6px 9px; margin-right: 8px; }
.experience-search button { height: 32px; padding: 6px 14px; }
.experience-pagination { display: flex; align-items: center; justify-content: center; margin: 12px 0; }
.experience-pagination button { height: 32px; padding: 6px 14px; margin: 0 15px; }
.experience-missing { padding: 12px; margin: 15px 0; border: 1px #805f32; background: #353025; }
.experience-missing b, .experience-missing small { display: block; margin-bottom: 7px; }
.experience-missing small { color: #c4b597; font-size: 10px; }
.experience-missing button { height: 30px; padding: 6px 12px; margin-right: 8px; }
#experience-file-shade { display: none; position: absolute; left: 0; top: 34px; bottom: 0; right: 0; pointer-events: auto; }
#experience-file-menu { width: 335px; padding: 8px; background: #2c3039; border: 1px #66758a; border-radius: 4px; }
#experience-file-menu button { display: block; text-align: left; width: 100%; height: 33px; padding: 8px 10px; border: 0px; background: transparent; font-size: 11px; }
#experience-file-menu button:hover { background: #3c506b; }
#experience-confirm { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: #10131bbd; justify-content: center; align-items: center; pointer-events: auto; }
.experience-confirm-card { width: 510px; padding: 27px; background: #292f39; border: 1px #63758f; border-radius: 8px; }
.experience-confirm-card h2 { font-size: 20px; margin: 0 0 16px; }
.experience-confirm-card p { font-size: 12px; line-height: 21px; color: #c8d1df; }
.experience-confirm-actions { display: flex; justify-content: flex-end; margin-top: 23px; }
.experience-confirm-actions button { height: 34px; margin-left: 9px; padding: 6px 13px; }
#experience-loading { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: #26394e; overflow: hidden; pointer-events: auto; }
#exp-loading-background { position: absolute; }
.experience-loading-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: #101826ad; }
.experience-loading-content { position: absolute; left: 10%; right: 10%; top: 23%; text-align: center; }
.experience-loading-icon { width: 116px; height: 116px; margin: 0 auto 20px; background: #384960; border: 1px #8299b1; border-radius: 18px; overflow: hidden; display: flex; justify-content: center; align-items: center; }
.experience-loading-icon img { width: 108px; height: auto; }
.experience-loading-content h1 { font-size: 29px; margin: 0 0 12px; }
#exp-loading-title { max-height: 96px; overflow: hidden; }
#exp-loading-description { max-height: 66px; overflow: hidden; }
.experience-loading-content p { color: #d3deec; font-size: 13px; line-height: 22px; margin: 0 auto 15px; max-width: 560px; }
.experience-loading-content button { height: 34px; padding: 6px 19px; margin-top: 17px; }
.experience-spinner { width: 35px; height: 5px; background: #8fc8ff; border-radius: 3px; margin: 25px auto 15px; animation: 0.8s alternate infinite experience-pulse; }
@keyframes experience-pulse { from { opacity: 0.25; transform: scaleX(0.5); } to { opacity: 1; transform: scaleX(1.4); } }
.experience-compact .experience-media { width: 240px; }
.experience-compact .experience-main { padding: 23px; }

/* ==========================================================================
   Home: launcher surface over the full-window video.
   Spacing scale 4 / 8 / 12 / 16 / 24 keeps the page compact at 1280x720.
   ========================================================================== */
#experience-home { background: transparent; }

.home-header { position: absolute; left: 32px; right: 32px; top: 14px; height: 56px; display: flex; align-items: center; justify-content: space-between; }
.home-header .experience-brand { height: auto; margin: 0; padding: 0; }
.home-header .experience-brand img { width: 40px; height: 40px; margin-right: 12px; }
.home-header .experience-brand b { font-size: 18px; letter-spacing: 2.5px; }
.home-header .experience-brand small { margin-left: 9px; font-size: 10px; letter-spacing: 1.6px; color: #a6a9b2; }

.home-navigation { display: flex; align-items: center; }
.home-navigation button { height: 32px; margin-left: 4px; padding: 0 14px; background: #1212167d; border: 1px #ffffff12; border-radius: 16px; color: #c3c6ce; font-size: 12px; }
.home-navigation button:hover { background: #2a2229e0; border-color: #ffffff26; color: #ffffff; }
.home-navigation button.active { background: #5a2530d9; border-color: #e34255; color: #ffffff; }

.experience-main { left: 0; right: 0; top: 88px; padding: 0 32px 28px; }
.experience-compact .experience-main { padding: 0 32px 28px; }
#experience-content { max-width: 1180px; }

/* Hero */
.home-intro { padding: 16px 0 22px; }
.home-intro small { font-size: 11px; letter-spacing: 3px; color: #e2a2a9; }
.home-intro h1 { font-size: 34px; line-height: 1.12; margin: 10px 0 8px; }
.home-intro p { font-size: 14px; line-height: 1.5; color: #cac4c8; margin: 0 0 18px; }
.home-actions { display: flex; }
.home-actions button { height: 40px; margin: 0 10px 0 0; padding: 0 20px; font-size: 13px; border-radius: 8px; background: #17161ad9; border: 1px #ffffff1f; color: #eceef2; }
.home-actions button:hover { background: #2a252bd9; border-color: #ffffff33; color: #ffffff; }
.home-actions .experience-primary { background: #ba2838; border-color: #e8505f; color: #ffffff; }
.home-actions .experience-primary:hover { background: #d63749; border-color: #f26371; }
.home-actions .experience-primary:active { background: #a01f2e; border-color: #cf3f4e; }

/* Engine default world */
.home-default-card { display: flex; align-items: center; margin: 0 0 18px; padding: 13px 16px; background: #141318b3; border: 1px #ffffff14; border-radius: 10px; }
.home-default-icon { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex: 0 0 44px; margin-right: 14px; background: #1e1b21; border: 1px #ffffff10; border-radius: 10px; }
.home-default-icon img { width: 26px; height: 26px; margin: 0; }
.home-default-copy { flex: 1; min-width: 0; }
.home-default-copy h2 { font-size: 15px; margin: 0 0 3px; }
.home-default-copy p { font-size: 12px; line-height: 16px; color: #c9c3c8; margin: 0 0 4px; }
.home-default-copy small { font-size: 9px; letter-spacing: 1.1px; color: #d98b96; }
.home-default-actions { flex: 0 0 auto; margin-left: 16px; }
.home-default-actions button { height: 34px; padding: 0 16px; border-radius: 7px; background: #2a1a21d9; border: 1px #df68794a; color: #f3e2e5; }
.home-default-actions button:hover { background: #3d222b; border-color: #e34255; color: #ffffff; }

/* Section headings */
.experience-section { display: flex; align-items: center; justify-content: space-between; margin: 0 0 10px; }
.experience-section-title { display: flex; align-items: center; }
.experience-section h2 { font-size: 15px; margin: 0; }
.experience-section-count { height: 18px; margin-left: 8px; padding: 1px 6px; background: #ffffff0f; border: 1px #ffffff14; border-radius: 9px; color: #b7b1b9; font-size: 10px; line-height: 14px; }
.experience-section > button { height: 26px; padding: 0 10px; background: transparent; border: 0px; border-radius: 6px; color: #e3a8b0; font-size: 12px; }
.experience-section > button:hover { background: #ffffff12; color: #ffffff; }

/* Recent experiences: compact dashboard rows */
.home-recent { display: flex; flex-wrap: wrap; margin: 0 -10px 0 0; }
.home-recent .experience-card { display: flex; align-items: center; flex-grow: 1; flex-basis: 520px; width: auto; margin: 0 10px 10px 0; padding: 12px; background: #141318c9; border: 1px #ffffff12; border-radius: 10px; overflow: visible; }
.home-recent .experience-card:hover { background: #1e1b21e0; border-color: #dc667473; }
.home-recent .experience-cover { width: 132px; height: 78px; flex: 0 0 132px; margin-right: 14px; border-radius: 8px; background: #262329; }
.home-recent .experience-cover img { width: 100%; height: auto; }
.home-recent .experience-cover img.experience-placeholder { width: 34px; height: 34px; }
.home-recent .experience-card-body { flex: 1 1 auto; min-width: 0; padding: 0; }
.home-recent .experience-card h3 { font-size: 15px; margin: 0 0 5px; }
.home-recent .experience-card p { height: auto; max-height: 32px; font-size: 12px; line-height: 16px; color: #b6b0b8; margin: 0 0 6px; overflow: hidden; }
.experience-card-meta { display: flex; align-items: center; }
.home-recent .experience-card small { font-size: 10px; color: #928d97; }
.experience-card-dot { width: 3px; height: 3px; margin: 0 6px; border-radius: 2px; background: #6d6873; }
.home-recent .experience-card-actions { display: flex; align-items: center; flex: 0 0 auto; margin: 0 0 0 14px; }
.home-recent .experience-card-actions button { height: 34px; margin: 0; padding: 0 16px; border-radius: 7px; font-size: 12px; }
.home-recent .experience-card-actions .experience-primary { min-width: 80px; background: #ba2838; border: 1px #e8505f; color: #ffffff; font-weight: bold; }
.home-recent .experience-card-actions .experience-primary:hover { background: #d63749; border-color: #f26371; }
.home-recent .experience-card-actions .experience-primary:active { background: #a01f2e; border-color: #cf3f4e; }
.home-recent .experience-card-actions .experience-primary:focus { border-color: #ffb3bb; }

/* The "..." button matches the profile of the primary action. */
.experience-card-actions .experience-more { width: 34px; min-width: 34px; padding: 0; background: #232128; border: 1px #ffffff14; border-radius: 7px; color: #d5d0d6; font-size: 16px; line-height: 30px; text-align: center; }
.home-recent .experience-more { height: 34px; margin-left: 8px; }
.experience-card-actions .experience-more:hover { background: #322c33; border-color: #ffffff2b; color: #ffffff; }
.experience-card-actions .experience-more.active, .experience-card-actions .experience-more:active { background: #3b2029; border-color: #e34255; color: #ffffff; }

/* Card menu: one anchored popover shared by Home and the library. */
.experience-card-menu { position: absolute; right: 8px; bottom: 46px; width: 214px; padding: 5px; background: #1a181df7; border: 1px #ffffff1f; border-radius: 9px; box-shadow: 0 14px 34px #000000b3; z-index: 8; }
.home-recent .experience-card-menu { top: 76px; bottom: auto; right: 12px; }
.experience-card-menu button { display: block; width: 100%; height: 30px; padding: 0 10px; background: transparent; border: 1px transparent; border-radius: 5px; color: #e8e3e8; font-size: 12px; text-align: left; }
.experience-card-menu button:hover { background: #2b272e; }
.experience-card-menu button:active { background: #3a1e26; }
.experience-card-menu button:focus { border-color: #e34255; }
.experience-card-menu button.experience-menu-danger { color: #ef8b95; }
.experience-card-menu button.experience-menu-danger:hover { background: #3a1d24; color: #ffb3ba; }
.experience-menu-rule { height: 1px; margin: 4px 6px; background: #ffffff14; }

/* Shared cards, forms and dialogs (library, archive, settings). */
.experience-card { width: 240px; background: #131316c9; border: 1px #ffffff14; border-radius: 9px; }
.experience-card:hover { border-color: #dc667480; background: #242126df; }
.experience-card h3 { font-size: 15px; }
.experience-card p { font-size: 12px; }
.experience-card-actions button { height: 32px; font-size: 12px; }
.experience-empty { width: 100%; padding: 26px; background: #1313168c; border: 0px; border-radius: 8px; font-size: 15px; color: #d6cdd1; }
.experience-form, .experience-title { padding: 20px; background: #131316d9; border-radius: 8px; }
.experience-confirm-card { background: #19191df5; border-color: #ffffff20; }
.experience-loading-shade { background: #09090bbd; }
.experience-spinner { background: #e34255; }
.experience-settings { padding: 24px; background: #151519e0; border-radius: 8px; }
.experience-settings button { display: block; width: 420px; max-width: 100%; height: 40px; margin-bottom: 12px; text-align: left; }
#exp-header-default-save { height: 26px; padding: 3px 10px; font-size: 11px; margin: 0 8px; }
#experience-form-actions { display: none; position: absolute; left: 0; right: 0; bottom: 0; height: 76px; padding: 16px 5%; margin: 0; background: #141318f2; border-top: 1px #ffffff16; }
#experience-form-actions button { height: 42px; padding: 10px 22px; font-size: 14px; }
