<rml><head><title>Loblox Studio</title><link type="text/rcss" href="../styles/studio.rcss"/><link type="text/rcss" href="../styles/player.rcss"/><link type="text/rcss" href="../styles/experiences.rcss"/></head>
<body id="studio">
 <div id="experience-host"/>
 <div id="header"><div class="brand"><img src="loblox-logo"/><b>LOBLOX</b><span>STUDIO</span></div><button id="experience-menu" data-experience="file" title="Experience files and templates">File</button><div id="project">Untitled place</div><div class="session"><button data-action="open-dialog" title="Open project · Ctrl+O"><img src="icon-folder"/></button><button data-action="save" title="Save project · Ctrl+S"><img src="icon-save"/></button><span class="separator"/><button id="play" data-action="play" title="Play · F5"><img src="icon-play"/>Play</button><button id="stop" data-action="stop" title="Stop · Shift+F5"><img src="icon-stop"/>Stop</button></div></div>
 <div id="tabs"><button id="tab-Home" data-tab="Home">Home</button><button id="tab-Model" data-tab="Model">Model</button><button id="tab-Avatar" data-tab="Avatar">Avatar</button><button id="tab-Script" data-tab="Script">Script</button><button id="tab-View" data-tab="View">View</button><button id="tab-Game" data-tab="Game">Game</button><div class="tab-spacer"/><button data-action="save-dialog" class="quiet">Save as…</button></div>
 <div id="ribbon"><div id="ribbon-tools"/><div id="snap-group"><div class="snap-heading"><label><input id="snap" data-action="snap" type="checkbox" checked="checked"/>Snap</label><select id="transform-space" data-action="transform-space" title="Move / Rotate reference · Ctrl+L. Scale always resizes local faces."><option value="world">World</option><option value="local">Local</option></select></div><div class="snap-field"><span>Move</span><input id="move-snap" data-action="move-snap" value="1"/></div><div class="snap-field"><span>Scale</span><input id="scale-snap" data-action="scale-snap" value="0.5"/></div><div class="snap-field"><span>Rotate °</span><input id="rotate-snap" data-action="rotate-snap" value="15"/></div></div></div>
 <div id="toolbox" class="panel">
  <div class="panel-heading"><img src="icon-toolbox"/>Toolbox<button data-action="toggle-toolbox" class="close">×</button></div>
  <div class="toolbox-filter"><select id="tool-category"><option value="all">All objects</option><option value="geometry">Geometry</option><option value="avatar">Avatar</option><option value="logic">Logic</option></select><input id="tool-search" placeholder="Search objects"/></div>
  <div id="toolbox-content" class="panel-content"><div class="tool-section">Insert objects</div><div id="object-grid" class="object-grid">
   <button data-action="part" data-category="geometry" data-search="part block"><img src="icon-part"/><span>Part</span></button><button data-action="sphere" data-category="geometry" data-search="sphere"><img src="icon-sphere"/><span>Sphere</span></button><button data-action="spawn" data-category="geometry" data-search="spawn"><img src="icon-spawn"/><span>Spawn</span></button>
   <button data-action="folder" data-category="geometry" data-search="folder"><img src="icon-folder"/><span>Folder</span></button><button data-action="model" data-category="geometry" data-search="model"><img src="icon-model"/><span>Model</span></button><button data-action="r6" data-category="avatar" data-search="r6 rig character"><img src="icon-rig"/><span>R6 rig</span></button>
   <button data-action="script" data-category="logic" data-search="script lua"><img src="icon-script"/><span>Script</span></button><button data-action="module" data-category="logic" data-search="module lua"><img src="icon-module"/><span>Module</span></button><button data-action="show:assets" data-category="geometry" data-search="image decal texture"><img src="icon-image"/><span>Images</span></button>
  </div><div class="tool-section">Project tools</div><button data-action="show:rig" class="list-command"><img src="icon-rig"/>Rig Editor</button><button data-action="show:animation" class="list-command"><img src="icon-animation"/>Animation Editor</button><button data-action="show:assets" class="list-command"><img src="icon-image"/>Import image…</button><p class="tool-note">Local objects and imported assets.<br/>No online marketplace.</p></div>
 </div>
 <div id="explorer" class="panel"><div class="panel-heading"><img src="icon-explorer"/>Explorer<div class="heading-actions"><button id="new-object" data-action="insert-menu" title="Insert object">+</button><button data-action="toggle-explorer" class="close">×</button></div></div><input id="tree-search" class="search" placeholder="Filter name or class"/><div id="tree"/></div>
 <div id="properties" class="panel"><div class="panel-heading"><img src="icon-properties"/>Properties<button data-action="toggle-properties" class="close">×</button></div><div id="property-title"/><input id="property-search" class="search" placeholder="Filter properties"/><div id="property-body"/></div>
 <div id="viewport-label"><div id="document-list"><div class="document-tab active" id="document-tab-0"><button id="document-0" class="doc-activate" data-action="activate-document" data-value="0" title="3D place viewport"><img src="icon-workspace"/><span class="doc-label">Place · Perspective</span></button></div></div><div id="editor-camera-modes"><button id="editor-camera-fps" data-action="editor-camera" data-value="fps" title="FPS: RMB looks in place; WASD moves; F frames selection">FPS</button><button id="editor-camera-focus" data-action="editor-camera" data-value="focus" title="Focus: RMB orbits the focal point; F frames selection">Focus</button></div><span id="viewport-hint" class="muted">RMB + WASD · Q / E</span></div>
 <div id="left-divider" class="divider vertical" data-split="left"/><div id="right-divider" class="divider vertical" data-split="right"/><div id="property-divider" class="divider horizontal" data-split="properties"/>
 <div id="advanced"><div id="advanced-tabs"><button id="advanced-script" data-advanced="script">Script Editor</button><button id="advanced-animation" data-advanced="animation">Animation</button><button id="advanced-rig" data-advanced="rig">Rig Editor</button><button id="advanced-settings" data-advanced="settings">Game Config</button><button id="advanced-output" data-advanced="output">Output</button><button id="advanced-assets" data-advanced="assets">Assets</button><button data-action="close-advanced" class="close">×</button></div><div id="advanced-content"/></div><div id="bottom-divider" class="divider horizontal" data-split="bottom"/>
 <div id="status"><span id="message">Ready</span><span id="scene-count"/></div>
 <div id="game-layer">
  <div id="game-topbar"><button id="game-menu" data-player-page="game" class="logo-button" title="Loblox · Game menu"><img src="loblox-logo"/></button><div id="game-capsule"><button id="game-controls" data-player-page="game" title="Menu · Esc"><img id="game-menu-icon" src="icon-player-menu"/></button><button id="game-settings" data-player-page="settings" title="Camera and controls"><img src="icon-player-settings"/></button></div></div>
  <div id="health" aria-label="Health 100 / 100"><div id="health-track" class="health-track"><div id="health-trail"/><div id="health-fill"/></div></div><div id="mouse-lock-cursor" aria-hidden="true"><img src="loblox-lock"/></div>
  <div id="pause"><div id="pause-panel" class="pause-panel">
   <div class="pause-tabs"><button id="page-game" data-page="game"><img src="icon-player-person"/><span>Game</span></button><button id="page-settings" data-page="settings"><img src="icon-player-settings"/><span>Settings</span></button><button id="page-controls" data-page="controls"><img src="icon-player-controls"/><span>Controls</span></button><button id="page-about" data-page="about"><img src="icon-info"/><span>About</span></button></div>
   <div id="pause-content">
    <div id="game-page"><div class="player-card"><div class="player-emblem"><img src="icon-player-person"/></div><div class="player-identity"><span class="player-eyebrow">LOCAL PLAYER</span><h2 id="player-name">R6Character</h2><span class="session-indicator">Test session paused</span></div><img class="session-logo" src="loblox-logo"/></div><div class="session-row"><span>Place</span><b id="map-name">Untitled place</b></div><div class="session-row"><span>Health</span><b id="pause-health">100 / 100</b></div><div class="setting-row"><div class="setting-copy"><span>Game view</span><small>More room to explore your world.</small></div><div class="session-actions"><button id="game-maximize" data-action="maximize-game" title="Immersive game view · F10">Maximize <span class="key-hint">F10</span></button><button id="game-fullscreen" data-action="fullscreen-game" title="Borderless fullscreen · F11">Fullscreen <span class="key-hint">F11</span></button></div></div><p class="session-note">Your place is safe. Changes in this test are discarded when you return to Studio.</p></div>
    <div id="settings-page">
     <div class="setting-row"><div class="setting-copy"><span>Camera mode</span><small>Choose how the camera follows your character.</small></div><div class="setting-control cycle"><button id="camera-previous" data-player-step="cameraMode" data-value="-1" title="Previous camera mode"><img src="icon-player-left"/></button><span id="camera-mode">Classic</span><button id="camera-next" data-player-step="cameraMode" data-value="1" title="Next camera mode"><img src="icon-player-right"/></button></div></div>
     <div class="setting-row"><div class="setting-copy"><span>Mouse sensitivity</span><small>Fine-tune how quickly your view turns.</small></div><div class="setting-control slider-control"><input id="sensitivity-slider" type="range" min="1" max="100" step="1" value="10" data-setting="sensitivityPercent"/><input id="sensitivity" class="player-number" type="text" value="0.003" data-setting="sensitivity" title="Mouse sensitivity · 0.0001 to 0.03"/></div></div>
     <div class="setting-row"><div class="setting-copy"><span>Camera distance</span><small>Set your preferred zoom distance.</small></div><div class="setting-control slider-control"><input id="distance-slider" type="range" min="0.3" max="30" step="0.1" value="12" data-setting="cameraDistance"/><input id="camera-distance" class="player-number" type="text" value="12" data-setting="cameraDistance" title="Camera distance in studs"/></div></div>
     <div class="setting-row"><div class="setting-copy"><span>Shift Lock</span><small>Press Shift during gameplay to lock the camera.</small></div><div class="setting-control cycle"><button id="shift-previous" data-player-step="enableShiftLock" data-value="-1" title="Toggle Shift Lock availability"><img src="icon-player-left"/></button><button id="shift-lock" class="cycle-value" data-player-step="enableShiftLock" data-value="1" title="Toggle Shift Lock availability">Off</button><button id="shift-next" data-player-step="enableShiftLock" data-value="1" title="Toggle Shift Lock availability"><img src="icon-player-right"/></button></div></div>
     <div class="setting-row"><div class="setting-copy"><span>First person</span><small>Allow zooming into your character's view.</small></div><div class="setting-control cycle"><button id="first-previous" data-player-step="allowFirstPerson" data-value="-1" title="Toggle first-person zoom"><img src="icon-player-left"/></button><button id="first-person" class="cycle-value" data-player-step="allowFirstPerson" data-value="1" title="Toggle first-person zoom">On</button><button id="first-next" data-player-step="allowFirstPerson" data-value="1" title="Toggle first-person zoom"><img src="icon-player-right"/></button></div></div>
     <div class="setting-row"><div class="setting-copy"><span>Fullscreen</span><small>Switch between Studio and a borderless game view.</small></div><div class="setting-control cycle"><button data-action="fullscreen-game" title="Toggle fullscreen · F11"><img src="icon-player-left"/></button><button id="fullscreen-value" class="cycle-value" data-action="fullscreen-game">Off</button><button data-action="fullscreen-game" title="Toggle fullscreen · F11"><img src="icon-player-right"/></button></div></div>
     <p id="player-setting-error"/><p class="session-note">Camera changes apply immediately to this play session. Save project defaults in Game Config.</p>
    </div>
    <div id="controls-page"><h2>Controls</h2><div class="control-row"><kbd>W A S D</kbd><span>Move relative to camera</span></div><div class="control-row"><kbd>Space</kbd><span>Jump</span></div><div class="control-row"><kbd>Right mouse</kbd><span>Rotate camera</span></div><div class="control-row"><kbd>Scroll</kbd><span>Zoom</span></div><div class="control-row"><kbd>Shift</kbd><span>Toggle Shift Lock, when enabled</span></div><div class="control-row"><kbd>Esc</kbd><span>Pause / resume</span></div><div class="control-row"><kbd>F10</kbd><span>Maximize game view</span></div><div class="control-row"><kbd>F11</kbd><span>Borderless fullscreen</span></div><div class="control-row"><kbd>Shift + F5</kbd><span>Stop test</span></div></div>
    <div id="about-page"><img class="about-logo" src="loblox-logo"/><h1>Loblox Studio</h1><p>Build, animate and play your own local 3D worlds.</p><p class="muted">C++ · raylib · Bullet · Lua · RmlUi</p></div>
   </div>
   <div class="pause-footer"><button id="leave" data-action="stop" title="Return to Studio · Shift+F5"><img src="icon-player-leave"/><span>Stop test</span></button><button id="respawn" data-action="respawn" title="Reset character"><img src="icon-respawn"/><span>Respawn</span></button><button id="resume" data-action="resume" class="primary" title="Resume gameplay · Esc"><span class="footer-key">ESC</span><span>Resume</span></button></div>
  </div></div>
 </div>
 <div id="context-menu"/><div id="tooltip"/>
 <div id="dialog-overlay"><div id="dialog"><h2 id="dialog-title"/><p id="dialog-description" class="muted"/><input id="dialog-value"/><div id="appearance-controls"/><p id="dialog-error"/><div class="dialog-footer"><button data-action="cancel-dialog">Cancel</button><button id="dialog-confirm" data-action="confirm-dialog" class="primary">Confirm</button></div></div></div>
</body></rml>
